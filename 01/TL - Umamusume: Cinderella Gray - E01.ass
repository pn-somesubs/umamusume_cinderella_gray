Dialogue: 0,0:00:00.00,0:00:10.00,Default,,0,0,0,,{\fs50\an7\fe162\b\fad(400,400)\bord2\blur5\shad\4c&H000000&\4a&HFF&\fnSweetest Cat Ever}\N{\pos(20,-2)}{\c&HFFFF00&}{\4c&H8485E4&}SomeSub ekip arkadaşı arıyor!\N{\pos(60,63)}{\c&HFFFFFF&}Çevirmen:{\c&HFFFF00&} Umav\N{\pos(60,111)}{\c&HFFFFFF&}Encode:{\c&HFFFF00&} Velnoxy\N{\pos(60,111)}{\c&HFFFFFF&}Redaktör:{\c&HFFFF00&} Myoupie\N{\c&HFFFFFF&}Discord:{\c&HFFFF00&} discord.gg/somesub
Dialogue: 0,0:00:00.47,0:00:02.63,Default,,0,0,0,,Sen! Adın ne?
Dialogue: 0,0:00:12.08,0:00:12.83,Default,,0,0,0,,Oguri Cap.
Dialogue: 0,0:00:16.82,0:00:17.71,Default,,0,0,0,,Lütfen!
Dialogue: 0,0:00:17.71,0:00:19.25,Default,,0,0,0,,Benim takımıma katıl!
Dialogue: 0,0:00:19.88,0:00:21.75,Default,,0,0,0,,Kesinlikle pişman olmayacaksın!
Dialogue: 0,0:00:21.91,0:00:22.92,Default,,0,0,0,,Kim bu?
Dialogue: 0,0:00:23.45,0:00:24.79,Default,,0,0,0,,Kitahara Jones.
Dialogue: 0,0:00:25.00,0:00:25.91,Default,,0,0,0,,K-Kim?
Dialogue: 0,0:00:26.57,0:00:28.70,Default,,0,0,0,,Ben gerçek bir yıldız yetiştirmek istiyorum!
Dialogue: 0,0:00:29.78,0:00:33.51,Default,,0,0,0,,Hayranların kalbine dokunan\Nve en çılgın hayallerine yanıt veren biri!
Dialogue: 0,0:00:33.51,0:00:35.45,Default,,0,0,0,,Gerçek canavar!
Dialogue: 0,0:00:37.01,0:00:39.53,Default,,0,0,0,,Ben senin içindeki potansiyeli gördüm!
Dialogue: 0,0:00:40.07,0:00:43.43,Default,,0,0,0,,Aklımıza koyarsak,\NTokai Derby'sini kazanmak bile mümkün!
Dialogue: 0,0:00:43.56,0:00:46.35,Default,,0,0,0,,T-T-T-Tokai Derby'si mi?
Dialogue: 0,0:00:46.35,0:00:49.70,Default,,0,0,0,,A-Ama o bir SP1 yarışı değil mi?
Dialogue: 0,0:00:50.02,0:00:50.77,Default,,0,0,0,,Öyle.
Dialogue: 0,0:00:51.53,0:00:55.20,Default,,0,0,0,,Bu yarış, dönemin en iyi koşucularını toplayıp.\NDönemin en iyisini belirler!
Dialogue: 0,0:00:55.50,0:00:56.86,Default,,0,0,0,,Onu kazanmak benim hayalim!
Dialogue: 0,0:00:57.25,0:00:58.32,Default,,0,0,0,,Ben bu hayali!
Dialogue: 0,0:00:58.32,0:01:00.49,Default,,0,0,0,,Gerçekleştirmek için\Nne gerekiyorsa yapacağım!
Dialogue: 0,0:01:00.67,0:01:02.62,Default,,0,0,0,,Hepsine göstermek istiyorum...
Dialogue: 0,0:01:02.62,0:01:04.44,Default,,0,0,0,,Kasamatsu'da da yıldızların olduğunu!
Dialogue: 0,0:01:06.73,0:01:09.13,Default,,0,0,0,,O yüzden sana yalvarıyorum...\Nhayalimi gerçekleştirmeme yardım et.
Dialogue: 0,0:01:09.49,0:01:10.18,Default,,0,0,0,,Oguri Cap!
Dialogue: 0,0:01:14.56,0:01:15.88,Default,,0,0,0,,Tüm bunları pek bilmiyorum ama...
Dialogue: 0,0:01:19.72,0:01:22.36,Default,,0,0,0,,Bir takıma girmeden yarışamam değil mi?
Dialogue: 0,0:01:23.65,0:01:26.11,Default,,0,0,0,,Durum buysa, senin takımına katılacağım.
Dialogue: 0,0:01:27.73,0:01:29.11,Default,,0,0,0,,Yarışmama izin ver.
Dialogue: 0,0:02:55.69,0:02:56.69,Default,,0,0,0,,UMAMUSUME
Dialogue: 0,0:02:56.98,0:03:01.95,Default,,0,0,0,,CINDERELLA GRAY
Dialogue: 0,0:03:02.87,0:03:05.66,Default,,0,0,0,,Bir Umamusume, bir antrenör tarafından keşfedildiğinde,
Dialogue: 0,0:03:05.66,0:03:08.42,Default,,0,0,0,,{\pos(1573,928)}BÖLÜM 2\NYARIŞMAMA İZİN VER{\fs8}
Dialogue: 0,0:03:05.66,0:03:08.42,Default,,0,0,0,,onların takımına katılır ve sonunda,
Dialogue: 0,0:03:08.42,0:03:11.12,Default,,0,0,0,,Yarış kariyerine resmen başlayabilir.
Dialogue: 0,0:03:11.96,0:03:15.00,Default,,0,0,0,,Hırsları veya yetenekleri ne olursa olsun.
Dialogue: 0,0:03:15.17,0:03:17.64,Default,,0,0,0,,Bu yeni koşucuları her şeyden önce bekleyen şey...
Dialogue: 0,0:03:17.75,0:03:20.08,Default,,0,0,0,,19 MAYIS: GENÇLER ÇIKIŞ YARIŞI\N...ilk yarışlarıdır.
Dialogue: 0,0:03:25.40,0:03:27.17,Default,,0,0,0,,Sanırım... Burası.
Dialogue: 0,0:03:27.89,0:03:30.10,Default,,0,0,0,,Bana rehberlik etmek zorunda kaldığın için üzgünüm.
Dialogue: 0,0:03:30.34,0:03:33.11,Default,,0,0,0,,Kendi başıma ne yaparsam yapayım ulaşamadım.
Dialogue: 0,0:03:34.73,0:03:38.94,Default,,0,0,0,,{\pos(941,98)}OKUL > KULÜP BİNASI 1. KAT > BURASI! [SAHA]
Dialogue: 0,0:03:34.73,0:03:38.45,Default,,0,0,0,,Yön bulma konusunda... oldukça kötüsün, değil mi?
Dialogue: 0,0:03:38.57,0:03:38.94,Default,,0,0,0,,Evet.
Dialogue: 0,0:03:41.27,0:03:43.07,Default,,0,0,0,,Oh, geldiniz demek!
Dialogue: 0,0:03:46.76,0:03:49.04,Default,,0,0,0,,Burası takımın toplandığı yer.
Dialogue: 0,0:03:49.61,0:03:53.09,Default,,0,0,0,,Yani, bir takımım olsaydı toplanırdı.\NHenüz başkasını keşfetmedim.
Dialogue: 0,0:03:56.12,0:03:58.00,Default,,0,0,0,,Ama bu bugün değişiyor.
Dialogue: 0,0:03:58.74,0:04:00.60,Default,,0,0,0,,TAKIM KAYDI\NBu evrakları imzaladığın an.
Dialogue: 0,0:04:00.60,0:04:02.69,Default,,0,0,0,,Resmi olarak takımıma kaydolmuş olacaksın!
Dialogue: 0,0:04:07.55,0:04:08.55,Default,,0,0,0,,Ah...
Dialogue: 0,0:04:09.06,0:04:12.22,Default,,0,0,0,,İnanamıyorum.\NŞimdiden bir takıma seçildi...
Dialogue: 0,0:04:13.82,0:04:16.49,Default,,0,0,0,,Bense sadece...
Dialogue: 0,0:04:17.12,0:04:17.96,Default,,0,0,0,,Al.
Dialogue: 0,0:04:17.96,0:04:18.47,Default,,0,0,0,,He?
Dialogue: 0,0:04:20.18,0:04:21.49,Default,,0,0,0,,Hm? İmzalamayacak mısın?
Dialogue: 0,0:04:21.77,0:04:23.74,Default,,0,0,0,,Ne? A-Ama ben...
Dialogue: 0,0:04:23.74,0:04:26.00,Default,,0,0,0,,Seçilmedim...
Dialogue: 0,0:04:26.78,0:04:28.12,Default,,0,0,0,,O da ne demek şimdi?
Dialogue: 0,0:04:28.25,0:04:30.58,Default,,0,0,0,,Henüz bir takıma seçilmedin mi?
Dialogue: 0,0:04:31.50,0:04:33.43,Default,,0,0,0,,Gidecek yerin yoksa benim takımıma katıl!
Dialogue: 0,0:04:33.68,0:04:35.52,Default,,0,0,0,,İkinizi de çalıştırabilirim, sorun değil.
Dialogue: 0,0:04:35.52,0:04:36.54,Default,,0,0,0,,Ah...
Dialogue: 0,0:04:36.54,0:04:37.58,Default,,0,0,0,,Belno?
Dialogue: 0,0:04:37.58,0:04:38.65,Default,,0,0,0,,Heh?
Dialogue: 0,0:04:39.65,0:04:40.71,Default,,0,0,0,,Takıma hoş geldin.
Dialogue: 0,0:04:44.72,0:04:47.87,Default,,0,0,0,,Evet! Birlikte antrenman yapmak için\Nsabırsızlanıyorum, Oguri-chan!
Dialogue: 0,0:04:51.47,0:04:52.05,Default,,0,0,0,,Pekâlâ.
Dialogue: 0,0:04:52.67,0:04:54.98,Default,,0,0,0,,Bunu da hallettiğimize göre,
Dialogue: 0,0:04:54.98,0:04:58.11,Default,,0,0,0,,Mevcut becerilerinizin hangi seviyede olduğuna bir bakalım.
Dialogue: 0,0:04:58.35,0:04:58.77,Default,,0,0,0,,Tamam!
Dialogue: 0,0:04:59.31,0:05:02.40,Default,,0,0,0,,Affedersin, ısınmama yardım edebilir misin?
Dialogue: 0,0:05:02.43,0:05:03.15,Default,,0,0,0,,Ah, tabii.
Dialogue: 0,0:05:05.73,0:05:07.08,Default,,0,0,0,,O-Oha...
Dialogue: 0,0:05:07.83,0:05:09.70,Default,,0,0,0,,Gerçekten çok esnek!
Dialogue: 0,0:05:09.77,0:05:12.16,Default,,0,0,0,,Her zaman bu kadar esnek miydin?
Dialogue: 0,0:05:12.73,0:05:15.08,Default,,0,0,0,,Aksine, tam tersiydi.
Dialogue: 0,0:05:15.33,0:05:16.33,Default,,0,0,0,,Nasıl yani?
Dialogue: 0,0:05:17.43,0:05:19.99,Default,,0,0,0,,Doğduğumda dizlerim.
Dialogue: 0,0:05:19.99,0:05:21.68,Default,,0,0,0,,Ayağa kalkamayacak kadar kötüydü.
Dialogue: 0,0:05:22.46,0:05:26.28,Default,,0,0,0,,Ama annem her gün saatlerce\Nbacaklarıma masaj yapardı...
Dialogue: 0,0:05:26.76,0:05:28.68,Default,,0,0,0,,Ve sonuç bu...
Dialogue: 0,0:05:29.49,0:05:30.28,Default,,0,0,0,,Noluyoz lan?
Dialogue: 0,0:05:30.63,0:05:33.27,Default,,0,0,0,,O ukala bücür,\NToz Yumağı'nın takımında mı?
Dialogue: 0,0:05:33.92,0:05:34.90,Default,,0,0,0,,Eh...
Dialogue: 0,0:05:35.25,0:05:36.23,Default,,0,0,0,,Vaaay...
Dialogue: 0,0:05:36.23,0:05:36.93,Default,,0,0,0,,Ah...
Dialogue: 0,0:05:36.93,0:05:37.94,Default,,0,0,0,,Neyse, çok da umurumda.
Dialogue: 0,0:05:37.94,0:05:40.50,Default,,0,0,0,,Hangi takımda olduğu umurumda değil.\NHiiç hem de.
Dialogue: 0,0:05:40.53,0:05:43.28,Default,,0,0,0,,Belli belli. Hiççç takmıyor gibi duruyorsun.
Dialogue: 0,0:05:43.28,0:05:44.13,Default,,0,0,0,,Düğün ne zaman?
Dialogue: 0,0:05:44.13,0:05:44.65,Default,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:05:45.08,0:05:48.32,Default,,0,0,0,,Uff, bizi gerçekten fena yendi.
Dialogue: 0,0:05:49.00,0:05:51.16,Default,,0,0,0,,Bağcıklarını bile çözmüştüm.
Dialogue: 0,0:05:51.54,0:05:53.79,Default,,0,0,0,,Ha? Ne yaptın sen?
Dialogue: 0,0:05:54.18,0:05:56.58,Default,,0,0,0,,Dostum, bu kadarı da adice... senin için bile.
Dialogue: 0,0:05:56.83,0:05:58.87,Default,,0,0,0,,Cidden fark etmedin mi?
Dialogue: 0,0:05:59.28,0:06:00.33,Default,,0,0,0,,Hmph.
Dialogue: 0,0:06:00.67,0:06:03.91,Default,,0,0,0,,Ne yapıyorsunuz siz?\NAntrenman yapıyor olmanız gerek!
Dialogue: 0,0:06:04.09,0:06:05.01,Default,,0,0,0,,Eyvah...
Dialogue: 0,0:06:05.01,0:06:06.88,Default,,0,0,0,,Baş belası geldi.
Dialogue: 0,0:06:07.78,0:06:13.14,Default,,0,0,0,,Zahmet edip, sizi takıma seçtiğim için\Nminnettar bile değilsiniz gibi...
Dialogue: 0,0:06:13.36,0:06:14.77,Default,,0,0,0,,Kes sesini be.
Dialogue: 0,0:06:14.95,0:06:18.73,Default,,0,0,0,,March'ı elinden kaçırıp bizimle kaldın diye\Nbozuluyorsun sadece.
Dialogue: 0,0:06:18.76,0:06:20.94,Default,,0,0,0,,Ne? Öyle bir şey yok!
Dialogue: 0,0:06:20.94,0:06:22.82,Default,,0,0,0,,Hiç de bozulmadım bir kere!
Dialogue: 0,0:06:24.12,0:06:28.15,Default,,0,0,0,,Yani, onu benden önce kaptığı için\Nbiraz sinirlenmiş olabilirim...
Dialogue: 0,0:06:34.12,0:06:37.50,Default,,0,0,0,,Fujimasa March...\NÇıkışı gerçekten muazzam.
Dialogue: 0,0:06:37.79,0:06:41.17,Default,,0,0,0,,O anlık hız patlaması,\Nonun kozu olacak.
Dialogue: 0,0:06:44.89,0:06:46.42,Default,,0,0,0,,Bence o bir önde koşucu.
Dialogue: 0,0:06:46.99,0:06:48.82,Default,,0,0,0,,En çok kısa mesafe yarışlarına uygun.
Dialogue: 0,0:06:51.37,0:06:52.75,Default,,0,0,0,,Güzel, iyi zamanla.
Dialogue: 0,0:06:57.68,0:06:59.23,Default,,0,0,0,,Kısa bir ara verelim.
Dialogue: 0,0:06:59.57,0:07:01.28,Default,,0,0,0,,Hayır, biraz daha çalışacağım.
Dialogue: 0,0:07:01.46,0:07:02.63,Default,,0,0,0,,Ama...
Dialogue: 0,0:07:06.71,0:07:09.23,Default,,0,0,0,,Ben senin içindeki potansiyeli gördüm!
Dialogue: 0,0:07:09.77,0:07:12.92,Default,,0,0,0,,Aklımızı koyarsak,\NTokai Derby'sini kazanmak bile mümkün!
Dialogue: 0,0:07:18.62,0:07:20.75,Default,,0,0,0,,Tokai Derby'sine gidecek olan benim.
Dialogue: 0,0:07:21.32,0:07:22.32,Default,,0,0,0,,Hm?
Dialogue: 0,0:07:23.09,0:07:25.88,Default,,0,0,0,,Birşey yok. Bir tur daha koşacağım.
Dialogue: 0,0:07:26.51,0:07:27.25,Default,,0,0,0,,H-Hey!
Dialogue: 0,0:07:30.14,0:07:33.26,Default,,0,0,0,,Görünüşe göre iletişim becerileri\Nüzerinde biraz çalışması gerek.
Dialogue: 0,0:07:40.61,0:07:43.56,Default,,0,0,0,,O formu başından sonuna kadar\Nkoruyabildiğine inanamıyorum.
Dialogue: 0,0:07:46.88,0:07:49.10,Default,,0,0,0,,Oguri-chan'ın dayanıklılığı... harika...
Dialogue: 0,0:07:50.21,0:07:53.12,Default,,0,0,0,,Dayanıklılık bir yana,\Ngücü de inanılmaz.
Dialogue: 0,0:07:53.36,0:07:54.99,Default,,0,0,0,,Kol hareketleri akıcı.
Dialogue: 0,0:07:54.99,0:07:57.93,Default,,0,0,0,,Alt vücut kasları da\Nmükemmel bir uyum içinde çalışıyor.
Dialogue: 0,0:07:58.17,0:07:58.90,Default,,0,0,0,,Bu gidişle.
Dialogue: 0,0:07:58.90,0:08:02.04,Default,,0,0,0,,19 Mayıs'ta ki çıkış yarışına kadar\Nsorunsuzca hedeflerine ulaşır.
Dialogue: 0,0:08:02.47,0:08:03.67,Default,,0,0,0,,Sana gelince, Belno...
Dialogue: 0,0:08:03.67,0:08:05.67,Default,,0,0,0,,Önce dayanıklılığını\Narttırarak başlayacağız.
Dialogue: 0,0:08:05.92,0:08:07.51,Default,,0,0,0,,Senin çıkış yarışın başka zaman.
Dialogue: 0,0:08:08.26,0:08:08.59,Default,,0,0,0,,T-Tamam...
Dialogue: 0,0:08:10.99,0:08:11.80,Default,,0,0,0,,Hm?
Dialogue: 0,0:08:11.80,0:08:12.80,Default,,0,0,0,,Cap!
Dialogue: 0,0:08:14.40,0:08:15.40,Default,,0,0,0,,Ne oldu?
Dialogue: 0,0:08:15.40,0:08:17.10,Default,,0,0,0,,Hiç yorulmuş gibi gözükmüyor.
Dialogue: 0,0:08:17.37,0:08:18.68,Default,,0,0,0,,Koşu tarzınla ilgili...
Dialogue: 0,0:08:19.08,0:08:20.83,Default,,0,0,0,,Bir önerim var.
Dialogue: 0,0:08:30.49,0:08:31.61,Default,,0,0,0,,Ee, ne düşünüyorsun?
Dialogue: 0,0:08:32.65,0:08:35.22,Default,,0,0,0,,B-Bunu başarabilirse\Nhızını arttırır sanırım...
Dialogue: 0,0:08:35.22,0:08:36.76,Default,,0,0,0,,Eğer üstesinden gelebilirse...
Dialogue: 0,0:08:37.30,0:08:40.54,Default,,0,0,0,,Çıkış yarışına az kaldı.\NDenemeye var mısın?
Dialogue: 0,0:08:45.73,0:08:48.76,Default,,0,0,0,,596, 597,
Dialogue: 0,0:08:49.27,0:08:52.15,Default,,0,0,0,,598, 599,
Dialogue: 0,0:08:52.75,0:08:53.53,Default,,0,0,0,,{\pos(913.5,91.5)}Çn:Canavar ya.
Dialogue: 0,0:08:52.75,0:08:53.53,Default,,0,0,0,,600!
Dialogue: 0,0:08:56.94,0:08:59.94,Default,,0,0,0,,Ooof...
Dialogue: 0,0:08:59.94,0:09:00.54,Default,,0,0,0,,Bir set daha.
Dialogue: 0,0:09:04.89,0:09:06.69,Default,,0,0,0,,Bugün biraz erken uyandım.
Dialogue: 0,0:09:08.34,0:09:09.57,Default,,0,0,0,,Ha?
Dialogue: 0,0:09:10.01,0:09:11.90,Default,,0,0,0,,Yemekhane açıldı mı bile?
Dialogue: 0,0:09:12.50,0:09:14.40,Default,,0,0,0,,Rahatça kahvaltımın tadını çıkarayım o zaman...
Dialogue: 0,0:09:15.15,0:09:15.94,Default,,0,0,0,,Pirinç bitmiş...
Dialogue: 0,0:09:16.53,0:09:17.13,Default,,0,0,0,,Belno?
Dialogue: 0,0:09:18.30,0:09:19.95,Default,,0,0,0,,G-Günaydın, Oguri-chan...
Dialogue: 0,0:09:19.95,0:09:22.22,Default,,0,0,0,,Sabah, sabah ne kadar çok şey yiyorsun.
Dialogue: 0,0:09:22.47,0:09:24.99,Default,,0,0,0,,Öğlene kadar bir şey yememem gerekiyor ne de olsa.
Dialogue: 0,0:09:24.99,0:09:28.13,Default,,0,0,0,,Kahvaltı ile öğle yemeği arasındaki zamana\Naç kalmak denilebileceğini sanmıyorum...
Dialogue: 0,0:09:32.82,0:09:35.13,Default,,0,0,0,,Görünüşe göre bu sabah koşuya çıkmış...
Dialogue: 0,0:09:36.12,0:09:37.95,Default,,0,0,0,,Bekle, okulun ilk gününde de...
Dialogue: 0,0:09:39.69,0:09:41.20,Default,,0,0,0,,O zaman da mı antrenman yapıyordu?
Dialogue: 0,0:09:43.62,0:09:44.64,Default,,0,0,0,,Hey, Oguri-chan?
Dialogue: 0,0:09:46.59,0:09:48.33,Default,,0,0,0,,Neden bu kadar çok koşuyorsun?
Dialogue: 0,0:09:52.83,0:09:55.56,Default,,0,0,0,,Ah, yani, derin bir şey kastetmemiştim!
Dialogue: 0,0:09:55.83,0:09:58.65,Default,,0,0,0,,Mesela ünlü olmak mı istiyorsun yoksa.
Dialogue: 0,0:09:58.65,0:10:01.50,Default,,0,0,0,,Yenmek istediğin birisi mi var?
Dialogue: 0,0:10:02.30,0:10:03.00,Default,,0,0,0,,Neden koşuyorum...
Dialogue: 0,0:10:06.99,0:10:08.04,Default,,0,0,0,,Koşabildiğim için?
Dialogue: 0,0:10:08.61,0:10:09.71,Default,,0,0,0,,Ne?
Dialogue: 0,0:10:10.04,0:10:10.95,Default,,0,0,0,,Ah...
Dialogue: 0,0:10:10.95,0:10:13.89,Default,,0,0,0,,Doğduğum zaman ayağa kalkamayacak kadar.
Dialogue: 0,0:10:13.92,0:10:15.34,Default,,0,0,0,,Dizlerim çok kötüydü.
Dialogue: 0,0:10:16.71,0:10:20.43,Default,,0,0,0,,Ayakta durabilmek ve koşabilmek...\NBu benim için mucize gibi bir şey.
Dialogue: 0,0:10:20.82,0:10:23.39,Default,,0,0,0,,Bu yüzden sadece koşmak bile beni mutlu ediyor.
Dialogue: 0,0:10:23.95,0:10:24.96,Default,,0,0,0,,Hepsi bu.
Dialogue: 0,0:10:30.78,0:10:33.00,Default,,0,0,0,,Koşuyorsun... çünkü koşabiliyorsun.
Dialogue: 0,0:10:34.57,0:10:36.57,Default,,0,0,0,,ANTRENÖR OFİSİ
Dialogue: 0,0:10:36.93,0:10:37.93,Default,,0,0,0,,Hmm...
Dialogue: 0,0:10:38.73,0:10:41.31,Default,,0,0,0,,Dört... hayır, belki altı?
Dialogue: 0,0:10:41.43,0:10:43.44,Default,,0,0,0,,Hadi ama, Jo-san ayağını çek!
Dialogue: 0,0:10:43.80,0:10:45.24,Default,,0,0,0,,A-Ah, benim hatam.
Dialogue: 0,0:10:46.89,0:10:47.22,Default,,0,0,0,,Bekle?
Dialogue: 0,0:10:47.55,0:10:48.62,Default,,0,0,0,,Shibasaki nerede?
Dialogue: 0,0:10:49.28,0:10:52.42,Default,,0,0,0,,Takımının odasına tıkılıp\Nkalacağını söyledi.
Dialogue: 0,0:10:52.42,0:10:54.54,Default,,0,0,0,,Yaklaşan bir yarış varmış galiba.
Dialogue: 0,0:10:54.67,0:10:55.75,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:10:57.35,0:11:00.01,Default,,0,0,0,,19 Mayıs'ta ki çıkış yarışının kadrosu belli oldu!
Dialogue: 0,0:11:00.18,0:11:01.01,Default,,0,0,0,,Kes sesini!
Dialogue: 0,0:11:01.01,0:11:02.68,Default,,0,0,0,,Alçak sesle konuş, ayı herif!
Dialogue: 0,0:11:02.68,0:11:04.93,Default,,0,0,0,,Ahaha, kusura bakmayın!
Dialogue: 0,0:11:04.93,0:11:08.00,Default,,0,0,0,,Ama şu kadroya bir göz atın hele!
Dialogue: 0,0:11:08.03,0:11:09.29,Default,,0,0,0,,Bizi tam bir gösteri bekliyor!
Dialogue: 0,0:11:09.68,0:11:11.90,Default,,0,0,0,,Bu yılın yeni gelenleri\Numut vaad ediyor sonuçta.
Dialogue: 0,0:11:11.90,0:11:15.73,Default,,0,0,0,,Gerçi sadece,\Nen iyileri hazır durumda...
Dialogue: 0,0:11:17.23,0:11:20.24,Default,,0,0,0,,OGURI CAP, BETHE SUGAR,\NSOUTH HEROINE, OKAN MAKER
Dialogue: 0,0:11:20.24,0:11:22.24,Default,,0,0,0,,FUJIMASA MARCH
Dialogue: 0,0:11:23.84,0:11:24.71,Default,,0,0,0,,Yok daha neler...
Dialogue: 0,0:11:35.96,0:11:38.46,Default,,0,0,0,,KASAMATSU TRACEN AKADEMİSİ YURDU
Dialogue: 0,0:11:49.40,0:11:50.12,Default,,0,0,0,,İyi günler!
Dialogue: 0,0:11:58.05,0:11:59.07,Default,,0,0,0,,Sevgili Oguri,
Dialogue: 0,0:11:59.56,0:12:01.42,Default,,0,0,0,,kendi yarışlarımda taktığım,
Dialogue: 0,0:12:01.42,0:12:03.66,Default,,0,0,0,,saç aksesuarını gönderiyorum.
Dialogue: 0,0:12:03.87,0:12:05.51,Default,,0,0,0,,Yarışta kullan tamam mı?
Dialogue: 0,0:12:05.51,0:12:06.39,Default,,0,0,0,,Sevgilerle, Annen.
Dialogue: 0,0:12:07.59,0:12:11.12,Default,,0,0,0,,Not: Yarışını radyodan dinliyor olacağım.
Dialogue: 0,0:12:12.72,0:12:13.72,Default,,0,0,0,,Anne...
Dialogue: 0,0:12:20.94,0:12:22.55,Default,,0,0,0,,Ah, üzgünüm...
Dialogue: 0,0:12:22.99,0:12:25.01,Default,,0,0,0,,{\pos(918,96)}ÇN:Tipe bak çok tatlı.
Dialogue: 0,0:12:22.99,0:12:25.01,Default,,0,0,0,,Şey, yani... Bak...
Dialogue: 0,0:12:25.02,0:12:28.43,Default,,0,0,0,,Akşam yemeğini birlikte yemek ister misin diye sormaya gelmiştim...
Dialogue: 0,0:12:30.06,0:12:31.18,Default,,0,0,0,,Oguri-chan...
Dialogue: 0,0:12:31.18,0:12:34.14,Default,,0,0,0,,Anneni gerçekten çok seviyor olmalısın, değil mi?
Dialogue: 0,0:12:36.09,0:12:37.29,Default,,0,0,0,,Ne?
Dialogue: 0,0:12:37.56,0:12:38.49,Default,,0,0,0,,Ah, be-bekle!
Dialogue: 0,0:12:38.88,0:12:40.86,Default,,0,0,0,,Bu gece özellikle iyi yemelisin!
Dialogue: 0,0:12:41.33,0:12:45.20,Default,,0,0,0,,Çünkü yarın Oguri-chan senin\Nçıkış yarışın var!
Dialogue: 0,0:12:51.75,0:12:55.00,Default,,0,0,0,,GENÇLER ÇIKIŞ YARIŞI GÜNÜ
Dialogue: 0,0:12:55.00,0:12:58.50,Default,,0,0,0,,KASAMATSU HİPODROMU
Dialogue: 0,0:12:58.50,0:13:01.00,Default,,0,0,0,,{\pos(981,146)}BEKLEME ODASI
Dialogue: 0,0:12:59.24,0:13:01.00,Default,,0,0,0,,Pekâlâ, iyi dinleyin.
Dialogue: 0,0:13:01.33,0:13:05.51,Default,,0,0,0,,Cap'in ilk yarışı,\Nöğleden sonra 14:30'da başlıyor.
Dialogue: 0,0:13:05.51,0:13:07.89,Default,,0,0,0,,Toprak pistte 800 metre.
Dialogue: 0,0:13:07.89,0:13:10.40,Default,,0,0,0,,{\pos(968,90)}KASAMATSU HİPODROMU / TRİBÜNLER
Dialogue: 0,0:13:07.89,0:13:10.40,Default,,0,0,0,,Kapılar burada açılacak.
Dialogue: 0,0:13:10.40,0:13:13.44,Default,,0,0,0,,Virajı dönüp yarışı burada,\Ntribünlerin önünde bitireceksiniz.
Dialogue: 0,0:13:13.99,0:13:16.12,Default,,0,0,0,,Mesafenin kısa olmasına ek olarak,\No viraj oldukça zorlu.
Dialogue: 0,0:13:16.12,0:13:18.61,Default,,0,0,0,,Bu da kapıdan geç çıkarsan \Nzor duruma düşeceğin anlamına geliyor.
Dialogue: 0,0:13:18.77,0:13:20.96,Default,,0,0,0,,Başka bir deyişle,\Niyi bir başlangıç kesinlikle kilit nokta.
Dialogue: 0,0:13:21.50,0:13:23.24,Default,,0,0,0,,İyi bir başlangıç kilit nokta...
Dialogue: 0,0:13:23.47,0:13:26.45,Default,,0,0,0,,Unutma, pistteki tek koşucu sen değilsin.
Dialogue: 0,0:13:26.45,0:13:29.28,Default,,0,0,0,,O pistteki herkes seninle birlikte pozisyon kapmak için mücadele edecek.
Dialogue: 0,0:13:30.44,0:13:33.44,Default,,0,0,0,,Lideri bulduğunda gözünü ondan ayırma.
Dialogue: 0,0:13:34.31,0:13:37.97,Default,,0,0,0,,Bitişe doğru son atağını yaparken onun konumunu dikkate al.
Dialogue: 0,0:13:38.27,0:13:39.71,Default,,0,0,0,,Liderden gözünü ayırma...
Dialogue: 0,0:13:43.16,0:13:44.69,Default,,0,0,0,,Anladı mı acaba?
Dialogue: 0,0:13:46.94,0:13:50.03,Default,,0,0,0,,KASAMATSU HİPODROMU\NEvet, görünüşe göre koşucularımız padoğa girdi.
Dialogue: 0,0:13:50.27,0:13:53.68,Default,,0,0,0,,İlk yarışına çıkan bu koşucular için bugün.
Dialogue: 0,0:13:53.68,0:13:55.63,Default,,0,0,0,,Yarış hünerlerini sergileyebilecekleri ilk gün.
Dialogue: 0,0:13:58.06,0:14:00.40,Default,,0,0,0,,Birinci kulvarda, bir numaralı çıkışta\NFujimasa March var.
Dialogue: 0,0:14:01.42,0:14:04.60,Default,,0,0,0,,İnsanlar Kasamatsu Tracen Akademisi'nin bu yıldızından çok umutlu.
Dialogue: 0,0:14:04.60,0:14:06.50,Default,,0,0,0,,Bugün açık ara farkla favori o.
Dialogue: 0,0:14:07.18,0:14:08.30,Default,,0,0,0,,FUJIMASA / MARCH\NÇok havalı...
Dialogue: 0,0:14:08.41,0:14:09.74,Default,,0,0,0,,Yapalirsin!
Dialogue: 0,0:14:12.05,0:14:14.58,Default,,0,0,0,,Sırada beşinci kulvarda, beş numaralı çıkışta...
Dialogue: 0,0:14:15.06,0:14:17.58,Default,,0,0,0,,Oguri Ca...hm?
Dialogue: 0,0:14:17.58,0:14:19.50,Default,,0,0,0,,Şey, yani...
Dialogue: 0,0:14:19.50,0:14:22.00,Default,,0,0,0,,Görünüşe göre formasını yıkamaya zamanı yetmemiş.
Dialogue: 0,0:14:22.00,0:14:22.66,Default,,0,0,0,,Çok iğrenç...
Dialogue: 0,0:14:22.96,0:14:23.68,Default,,0,0,0,,Harbici misin sen?
Dialogue: 0,0:14:26.20,0:14:28.24,Default,,0,0,0,,Bu da ne?\NOguri Cap bir şey çıkarıyor!
Dialogue: 0,0:14:31.18,0:14:32.43,Default,,0,0,0,,{\pos(942,121.5)}ÇN:Gel de yeme bu tatlılığı.
Dialogue: 0,0:14:31.18,0:14:32.43,Default,,0,0,0,,Bir saç aksesuarı!
Dialogue: 0,0:14:32.43,0:14:35.06,Default,,0,0,0,,Ve şimdi... onu takıyor!
Dialogue: 0,0:14:36.00,0:14:37.31,Default,,0,0,0,,Şey, eee...
Dialogue: 0,0:14:38.00,0:14:40.00,Default,,0,0,0,,Modayı çok yakından takip ediyor olmalı!
Dialogue: 0,0:14:40.18,0:14:42.55,Default,,0,0,0,,Spiker bile\Nne diyeceğini bilemedi.
Dialogue: 0,0:14:43.36,0:14:45.43,Default,,0,0,0,,Ama neden durup dururken şimdi taktı ki?
Dialogue: 0,0:14:46.23,0:14:48.49,Default,,0,0,0,,Hehe, sonunda taktı demek.
Dialogue: 0,0:14:49.60,0:14:51.20,Default,,0,0,0,,Lanet olsun, Shibasaki!
Dialogue: 0,0:14:51.20,0:14:54.07,Default,,0,0,0,,Bizimle aynı yarışı seçmeye nasıl cüret edersin?
Dialogue: 0,0:14:54.40,0:14:56.11,Default,,0,0,0,,Bilmiyordum dedim!
Dialogue: 0,0:14:58.55,0:15:00.87,Default,,0,0,0,,Jo-san Bu durum için gerçekten üzgünüm.
Dialogue: 0,0:15:00.88,0:15:02.58,Default,,0,0,0,,Ama bügün biz kazanacağız.
Dialogue: 0,0:15:03.13,0:15:05.09,Default,,0,0,0,,O kız tam bir dahi.
Dialogue: 0,0:15:05.29,0:15:08.05,Default,,0,0,0,,Hem zekaya hem de güce sahip...
Dialogue: 0,0:15:08.05,0:15:10.48,Default,,0,0,0,,Ve hepsini bir anda\Nortaya koyabiliyor.
Dialogue: 0,0:15:10.88,0:15:15.10,Default,,0,0,0,,Öyle mi?! Ha, Cap de en az onun kadar iyi!\NOnun... şey...
Dialogue: 0,0:15:15.73,0:15:17.41,Default,,0,0,0,,Dizleri yumuşacık!
Dialogue: 0,0:15:17.74,0:15:20.69,Default,,0,0,0,,Doğru ya!\NAyrıca annesini çok ama çok seviyor!
Dialogue: 0,0:15:21.22,0:15:22.90,Default,,0,0,0,,Bu işte pek iyi değilsiniz...
Dialogue: 0,0:15:24.01,0:15:27.31,Default,,0,0,0,,Tüm koşucular kapılarda toplandı,\Nyarışın başlamasını bekliyorlar.
Dialogue: 0,0:15:28.93,0:15:30.55,Default,,0,0,0,,Şunları iyice sıkı bağlasam iyi olacak.
Dialogue: 0,0:15:36.43,0:15:37.24,Default,,0,0,0,,Oguri Cap.
Dialogue: 0,0:15:40.33,0:15:41.41,Default,,0,0,0,,Sana karşı kaybetmeyeceğim.
Dialogue: 0,0:15:43.12,0:15:45.40,Default,,0,0,0,,Tokai Derby'sine gidecek\Nkişi ben olacağım.
Dialogue: 0,0:15:52.37,0:15:53.60,Default,,0,0,0,,Tokai Derby'si...
Dialogue: 0,0:15:55.88,0:15:57.23,Default,,0,0,0,,TOKAI DERBY'Sİ Mİ?\NO neydi ki?"
Dialogue: 0,0:15:58.88,0:16:03.02,Default,,0,0,0,,Şimdi, hazırlıkların tamamlanmasıyla,\Nkoşucularımız kapılarına giriyor!
Dialogue: 0,0:16:03.47,0:16:05.27,Default,,0,0,0,,Diğerleri hiç rakip olamaz.
Dialogue: 0,0:16:05.60,0:16:08.48,Default,,0,0,0,,Biri olacaksa... \NO da Oguri Cap olur.
Dialogue: 0,0:16:09.00,0:16:10.82,Default,,0,0,0,,İkimiz arasında düello olucak.
Dialogue: 0,0:16:12.17,0:16:14.41,Default,,0,0,0,,Herkes sıraya girdiğine göre,
Dialogue: 0,0:16:14.41,0:16:16.49,Default,,0,0,0,,800 metrelik çıkış yarışı başlayabilir!
Dialogue: 0,0:16:19.58,0:16:21.33,Default,,0,0,0,,Bu yarış başladığında...
Dialogue: 0,0:16:21.96,0:16:23.66,Default,,0,0,0,,Ne kadar zayıf olduğunu göreceksin!
Dialogue: 0,0:16:26.57,0:16:28.34,Default,,0,0,0,,Kapılar açılıyor ve koşucularımız fırlıyor!
Dialogue: 0,0:16:28.82,0:16:30.38,Default,,0,0,0,,İşte bu! Mükemmel bir çıkış!
Dialogue: 0,0:16:31.01,0:16:31.80,Default,,0,0,0,,Cap ne yaptı?
Dialogue: 0,0:16:31.80,0:16:32.88,Default,,0,0,0,,Ne...!
Dialogue: 0,0:16:33.83,0:16:37.00,Default,,0,0,0,,Bir yarış için en temiz başlangıç olmadı,\Nama çıkış yarışı başladı!
Dialogue: 0,0:16:37.62,0:16:40.35,Default,,0,0,0,,Acaba hangi koşucu zaferi kazanacak?
Dialogue: 0,0:16:41.31,0:16:43.10,Default,,0,0,0,,Eyvah, bir koşucu kapıdan geç çıktı!
Dialogue: 0,0:16:43.87,0:16:47.23,Default,,0,0,0,,Beş numara, Oguri Cap!\N Oguri Cap geç bir başlangıç yapıyor!
Dialogue: 0,0:16:48.56,0:16:51.83,Default,,0,0,0,,Oguri Cap şu anda\Ngrubun gerisinde kalıyor!
Dialogue: 0,0:16:52.51,0:16:54.49,Default,,0,0,0,,Nihihi, ezik.
Dialogue: 0,0:16:54.49,0:16:56.74,Default,,0,0,0,,Ayakkabı bağcıkları yine mi açıldı...
Dialogue: 0,0:16:58.12,0:16:59.36,Default,,0,0,0,,Yemin ederim ben bir şey yapmadım!
Dialogue: 0,0:16:59.96,0:17:02.81,Default,,0,0,0,,Ona iyi bir çıkışın kilit nokta olduğunu söylemiştim...
Dialogue: 0,0:17:03.11,0:17:04.07,Default,,0,0,0,,İşte böyle, March!
Dialogue: 0,0:17:08.27,0:17:11.54,Default,,0,0,0,,Oguri neden... ayaklarına bakıyor?
Dialogue: 0,0:17:17.53,0:17:20.89,Default,,0,0,0,,Geç başlamasına rağmen Oguri Cap\Ngrubun arkasına yetişti!
Dialogue: 0,0:17:21.74,0:17:23.63,Default,,0,0,0,,Güzel, işte bu! Hâlâ bir şansımız var!
Dialogue: 0,0:17:25.34,0:17:28.16,Default,,0,0,0,,Üç numara, South Heroine önde,
Dialogue: 0,0:17:28.19,0:17:30.11,Default,,0,0,0,,ikinci sırada Sekai Toha onu takip ediyor!
Dialogue: 0,0:17:30.11,0:17:34.13,Default,,0,0,0,,Son olarak, onları içten takip eden!
Dialogue: 0,0:17:34.13,0:17:36.38,Default,,0,0,0,,Favori Fujimasa March, şu anda üçüncü sırada!
Dialogue: 0,0:17:37.16,0:17:39.71,Default,,0,0,0,,Kitahara gözünü liderden\Nayırma demişti ama...
Dialogue: 0,0:17:41.39,0:17:43.37,Default,,0,0,0,,Onu... göremiyorum.
Dialogue: 0,0:17:44.00,0:17:47.42,Default,,0,0,0,,Koşucular şimdi\Nüçüncü viraja giriyor!
Dialogue: 0,0:17:48.36,0:17:49.25,Default,,0,0,0,,H-Ha!
Dialogue: 0,0:17:49.25,0:17:50.53,Default,,0,0,0,,Ah!
Dialogue: 0,0:17:50.53,0:17:50.86,Default,,0,0,0,,Pardon!
Dialogue: 0,0:17:52.36,0:17:52.80,Default,,0,0,0,,Ne oluyor ya?
Dialogue: 0,0:17:54.34,0:17:55.63,Default,,0,0,0,,Pfft, derdi ne bunun?
Dialogue: 0,0:17:55.63,0:17:57.13,Default,,0,0,0,,Önüne baksana salak.
Dialogue: 0,0:17:57.91,0:17:59.89,Default,,0,0,0,,Bekle, neden?! Neden dış kulvara geçti ki?!
Dialogue: 0,0:18:00.25,0:18:01.47,Default,,0,0,0,,Fizik.
Dialogue: 0,0:18:01.64,0:18:07.81,Default,,0,0,0,,MERKEZKAÇ KUVVETİ\NBir koşucu döndüğünde, merkezkaç kuvveti\Nvücudunun kütle merkezini dışarı iter!
Dialogue: 0,0:18:08.00,0:18:10.11,Default,,0,0,0,,Bu kadar keskin bir virajda,
Dialogue: 0,0:18:10.11,0:18:13.45,Default,,0,0,0,,tüm koşucular kümelenmişken\Nçarpışmalar yaşanabilir.
Dialogue: 0,0:18:13.57,0:18:14.53,Default,,0,0,0,,Ama bu...
Dialogue: 0,0:18:14.91,0:18:18.19,Default,,0,0,0,,March, kalabalığın tehlikelerinden kaçınmak için\Nöne geçti...
Dialogue: 0,0:18:18.76,0:18:20.44,Default,,0,0,0,,Ne harika yarışçı içgüdüleri!
Dialogue: 0,0:18:24.28,0:18:28.41,Default,,0,0,0,,Sakin ol şimdi. Düzlük ileride...\NGerçek yarış orada başlıyor.
Dialogue: 0,0:18:29.19,0:18:31.24,Default,,0,0,0,,Ve öndeki bunu\Ndaha fazla sürdüremez.
Dialogue: 0,0:18:33.61,0:18:35.71,Default,,0,0,0,,Grup dördüncü viraja yaklaşıyor!
Dialogue: 0,0:18:35.71,0:18:40.18,Default,,0,0,0,,South Heroine liderliğini koruyor,\NFujimasa March hemen arkasından takip ediyor!
Dialogue: 0,0:18:40.51,0:18:43.42,Default,,0,0,0,,Grubun geri kalanı temposunu artırıyor\Nve arayı kapatıyor!
Dialogue: 0,0:18:44.71,0:18:45.60,Default,,0,0,0,,Henüz değil...
Dialogue: 0,0:18:50.46,0:18:51.46,Default,,0,0,0,,Şimdi!
Dialogue: 0,0:18:53.34,0:18:55.50,Default,,0,0,0,,Bir numara, Fujimasa March hızlanıyor!
Dialogue: 0,0:18:55.50,0:18:57.09,Default,,0,0,0,,South Heroine'i geçebilecek mi?!
Dialogue: 0,0:19:01.86,0:19:03.12,Default,,0,0,0,,Sonra görüşürüz.
Dialogue: 0,0:19:03.48,0:19:05.03,Default,,0,0,0,,Fujimasa March liderliği ele geçiriyor!
Dialogue: 0,0:19:05.36,0:19:07.63,Default,,0,0,0,,Ah-yapaamıyorum!
Dialogue: 0,0:19:07.83,0:19:09.55,Default,,0,0,0,,FUJIMASA / MARCH\NYok artık! Şunun gidişine bak!
Dialogue: 0,0:19:09.75,0:19:10.35,Default,,0,0,0,,İşte bu be.
Dialogue: 0,0:19:10.35,0:19:11.67,Default,,0,0,0,,Yapabilirsin!
Dialogue: 0,0:19:11.91,0:19:14.28,Default,,0,0,0,,- İşte bu! İşte bu!\N- Hayır, hayır, hayır!
Dialogue: 0,0:19:15.03,0:19:16.23,Default,,0,0,0,,Son 200 metre!
Dialogue: 0,0:19:21.99,0:19:23.00,Default,,0,0,0,,Lider... işte orada!
Dialogue: 0,0:19:24.09,0:19:27.06,Default,,0,0,0,,Şu koşu tarzınla ilgili...\Nbir önerim var...
Dialogue: 0,0:19:27.63,0:19:32.06,Default,,0,0,0,,Kasamatsu Hipodromu, yumuşak nehir kumundan\Noluşan toprak bir pisttir.
Dialogue: 0,0:19:32.38,0:19:35.23,Default,,0,0,0,,Sadece adımlarında daha fazla\Ngüç gerektirmekle kalmaz.
Dialogue: 0,0:19:35.23,0:19:37.19,Default,,0,0,0,,Aynı zamanda bir püf noktası da vardır.
Dialogue: 0,0:19:37.19,0:19:38.16,Default,,0,0,0,,Püf noktası mı?
Dialogue: 0,0:19:39.45,0:19:40.54,Default,,0,0,0,,Ayak bileklerin.
Dialogue: 0,0:19:41.21,0:19:45.99,Default,,0,0,0,,Koşarken öne eğiliyorsun,\Nama o alçak ağırlık merkezinin dezavantajları var...
Dialogue: 0,0:19:46.52,0:19:49.58,Default,,0,0,0,,Kaygan kum, ihtimalen adımlarının\Ngücünü dağıtacaktır.
Dialogue: 0,0:19:50.38,0:19:51.52,Default,,0,0,0,,Püf noktası da burada yatıyor...
Dialogue: 0,0:19:51.96,0:19:55.34,Default,,0,0,0,,Önce, kumu kavrar gibi ayaklarını\Ntam olarak kuma bas.
Dialogue: 0,0:19:55.34,0:20:00.15,Default,,0,0,0,,Ardından öne kay ve kumu arkaya itmek için\Nayak bileklerini kullan!
Dialogue: 0,0:20:00.96,0:20:03.78,Default,,0,0,0,,Bir bakıma koşmaktan çok\Nyüzmeye benzer.
Dialogue: 0,0:20:04.44,0:20:07.97,Default,,0,0,0,,Temelde kendinizi kumda ilerletmek için\Nayak bileklerinizi kullanıyor olacaksınız.
Dialogue: 0,0:20:07.97,0:20:11.77,Default,,0,0,0,,Bu yüzden bu strateji\Nonların gücüne bağlı.
Dialogue: 0,0:20:12.70,0:20:15.10,Default,,0,0,0,,Şu andan itibaren ayak bileği\Nkaslarını çalıştırmanı istiyorum.
Dialogue: 0,0:20:15.67,0:20:18.94,Default,,0,0,0,,Kasamatsu'da kazanmanın anahtarı\Nonlar olacak.
Dialogue: 0,0:20:22.23,0:20:23.70,Default,,0,0,0,,Enerjim fazlasıyla var...
Dialogue: 0,0:20:23.81,0:20:25.20,Default,,0,0,0,,Ve lideri görebiliyorum.
Dialogue: 0,0:20:26.28,0:20:27.99,Default,,0,0,0,,Yüzüyormuş gibi yap.
Dialogue: 0,0:20:28.70,0:20:30.00,Default,,0,0,0,,Kumu kavra...
Dialogue: 0,0:20:30.67,0:20:31.35,Default,,0,0,0,,Öne eğil...
Dialogue: 0,0:20:32.52,0:20:33.20,Default,,0,0,0,,Geriye doğru it!
Dialogue: 0,0:20:34.08,0:20:35.08,Default,,0,0,0,,Vay canına!
Dialogue: 0,0:20:35.64,0:20:37.66,Default,,0,0,0,,Dış kulvardan hızla bir koşucu geliyor!
Dialogue: 0,0:20:38.09,0:20:39.09,Default,,0,0,0,,Ne?!
Dialogue: 0,0:20:39.87,0:20:40.96,Default,,0,0,0,,Bu Oguri Cap!
Dialogue: 0,0:20:41.26,0:20:44.73,Default,,0,0,0,,Beş numara, Oguri Cap!\NOguri Cap atağa geçiyor!
Dialogue: 0,0:20:45.13,0:20:47.02,Default,,0,0,0,,- Ne?\N- Ne?
Dialogue: 0,0:20:47.02,0:20:49.22,Default,,0,0,0,,- İşte buuu!\N- Kooş!
Dialogue: 0,0:20:49.22,0:20:50.65,Default,,0,0,0,,Koş, March!
Dialogue: 0,0:20:51.49,0:20:53.77,Default,,0,0,0,,Oguri Cap öne doğru fırlıyor!
Dialogue: 0,0:20:54.94,0:20:57.91,Default,,0,0,0,,Bu çok daha kolay.\NÜstelik daha hızlı hissediyorum.
Dialogue: 0,0:21:00.52,0:21:01.65,Default,,0,0,0,,Kitahara...
Dialogue: 0,0:21:02.96,0:21:04.48,Default,,0,0,0,,Bu işi biliyor.
Dialogue: 0,0:21:07.45,0:21:10.70,Default,,0,0,0,,Kabaran bir fırtına gibi lideri kovalayan,\Nbeş numara, Oguri Cap!
Dialogue: 0,0:21:10.70,0:21:12.64,Default,,0,0,0,,Baş döndürücü bir hızla yaklaşıyor!
Dialogue: 0,0:21:13.51,0:21:16.75,Default,,0,0,0,,Oguri Cap öne atılarak ikinciliği kolayca kapıyor!
Dialogue: 0,0:21:16.75,0:21:18.26,Default,,0,0,0,,Ama hedefinde Fujimasa March var!
Dialogue: 0,0:21:19.18,0:21:22.05,Default,,0,0,0,,Oguri Cap yaklaşırken\NFujimasa March koşmaya devam ediyor!
Dialogue: 0,0:21:22.90,0:21:23.94,Default,,0,0,0,,Başa baş bir mücadele!
Dialogue: 0,0:21:24.79,0:21:27.76,Default,,0,0,0,,Benim hedefim Tokai Derby şampiyonu olmak.
Dialogue: 0,0:21:28.93,0:21:30.31,Default,,0,0,0,,Bu seviyede bir yarışta.
Dialogue: 0,0:21:31.80,0:21:33.33,Default,,0,0,0,,kazanmana izin vereceğimi mi sanıyorsun?!
Dialogue: 0,0:21:34.21,0:21:37.21,Default,,0,0,0,,Fujimasa March hızlanarak\Nbir kez daha öne atılıyor!
Dialogue: 0,0:21:40.78,0:21:42.15,Default,,0,0,0,,Caaap!
Dialogue: 0,0:21:42.15,0:21:43.69,Default,,0,0,0,,Oguri-chan?
Dialogue: 0,0:21:46.62,0:21:49.14,Default,,0,0,0,,Ancak Oguri Cap amansız takibini sürdürüyor!
Dialogue: 0,0:21:49.89,0:21:53.66,Default,,0,0,0,,Yetişti!\NOguri Cap, Fujimasa March'a yetişti!
Dialogue: 0,0:21:54.32,0:21:55.77,Default,,0,0,0,,Son 100 metre!
Dialogue: 0,0:21:56.91,0:21:58.83,Default,,0,0,0,,Bir numara Fujimasa March mı olacak?
Dialogue: 0,0:21:58.83,0:22:00.75,Default,,0,0,0,,Yoksa beş numara Oguri Cap mi?
Dialogue: 0,0:23:39.08,0:23:41.78,Default,,0,0,0,,Gelecek bölüm\NUmamusume: Cinderella Gray'de!
Dialogue: 0,0:23:42.20,0:23:44.81,Default,,0,0,0,,3. Bölüm - Zirveden Manzara
