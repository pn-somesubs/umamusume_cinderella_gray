Dialogue: 0,0:00:00.00,0:00:10.00,Default,,0,0,0,,{\fs50\an7\fe162\b\fad(400,400)\bord2\blur5\shad\4c&H000000&\4a&HFF&\fnSweetest Cat Ever}\N{\pos(20,-2)}{\c&HFFFF00&}{\4c&H8485E4&}SomeSub ekip arkadaşı arıyor!\N{\pos(60,63)}{\c&HFFFFFF&}Çevirmen:{\c&HFFFF00&} OxyGen\N{\pos(60,111)}{\c&HFFFFFF&}Encode:{\c&HFFFF00&} Velnoxy\N{\pos(60,111)}{\c&HFFFFFF&}Redaktör:{\c&HFFFF00&} Myoupie\N{\c&HFFFFFF&}Discord:{\c&HFFFF00&} discord.gg/somesub
Dialogue: 0,0:00:03.57,0:00:04.30,Default,,0,0,0,,Umamusume
Dialogue: 0,0:00:06.44,0:00:09.66,Default,,0,0,0,,Onlar koşmak için doğarlar.
Dialogue: 0,0:00:12.49,0:00:14.87,Default,,0,0,0,,Ve isimlerini başka dünyalardan miras alırlar.
Dialogue: 0,0:00:14.87,0:00:16.66,Default,,0,0,0,,Ve hayallerden ilham alırlar.
Dialogue: 0,0:00:17.46,0:00:19.79,Default,,0,0,0,,En dramatik ve harika hayallerden.
Dialogue: 0,0:00:20.75,0:00:23.38,Default,,0,0,0,,Şimdi ise, daima ileriye koşuyorlar...
Dialogue: 0,0:00:24.59,0:00:27.26,Default,,0,0,0,,Bu, onların kaderi.
Dialogue: 0,0:00:30.43,0:00:32.80,Default,,0,0,0,,Hiç kimse bilmez.
Dialogue: 0,0:00:33.10,0:00:35.35,Default,,0,0,0,,Önlerinde uzanan yarışların nasıl,
Dialogue: 0,0:00:35.35,0:00:37.14,Default,,0,0,0,,geleceklerinde nasıl sonlanacağını bilmezler.
Dialogue: 0,0:00:39.23,0:00:41.48,Default,,0,0,0,,Şimdi bile, koşmaya devam ediyorlar,
Dialogue: 0,0:00:42.61,0:00:45.53,Default,,0,0,0,,sadece hedefe odaklanarak.
Dialogue: 0,0:00:45.53,0:00:46.40,Default,,0,0,0,,Önlerindeki hedeflere.
Dialogue: 0,0:00:51.28,0:00:52.24,Default,,0,0,0,,Dışarıdan,
Dialogue: 0,0:00:52.24,0:00:53.91,Default,,0,0,0,,Yamano Piache öne atılıp pozisyonunu alıyor.
Dialogue: 0,0:00:53.91,0:00:55.16,Default,,0,0,0,,Geriye 800 metre kaldı.
Dialogue: 0,0:00:56.70,0:00:59.87,Default,,0,0,0,,{\pos(970,141)}Herkesin gözdesi Cloud Earth\Nşuanda liderin on beş boy gerisinde!
Dialogue: 0,0:00:59.87,0:01:01.37,Default,,0,0,0,,{\pos(890,82)}Şimdi dış kulvara yöneliyor.
Dialogue: 0,0:01:01.83,0:01:04.38,Default,,0,0,0,,Yarışçılar 600 metre tabelasını geride bıraktı!
Dialogue: 0,0:01:05.04,0:01:07.17,Default,,0,0,0,,Ve şimdi, 4. köşeyi dönüyorlar!
Dialogue: 0,0:01:07.17,0:01:09.17,Default,,0,0,0,,Japon Derbisi'nin\Nson düzlüğüne girdik!
Dialogue: 0,0:01:12.51,0:01:15.05,Default,,0,0,0,,LUNA SWALLOW\NŞuanda liderlik Luna Swallow'da!
Dialogue: 0,0:01:15.05,0:01:16.75,Default,,0,0,0,,Luna Swallow şu anda hâlâ pozizyonunu koruyor!
Dialogue: 0,0:01:17.68,0:01:18.64,Default,,0,0,0,,Bu da ne?
Dialogue: 0,0:01:18.64,0:01:20.73,Default,,0,0,0,,O muhteşem altın sarısı\N saçların tek bir anlamı olabilir...
Dialogue: 0,0:01:20.77,0:01:22.77,Default,,0,0,0,,Gold City! İşte geliyor!
Dialogue: 0,0:01:25.61,0:01:28.11,Default,,0,0,0,,Gooold! Koooş! Koooş!
Dialogue: 0,0:01:28.57,0:01:30.65,Default,,0,0,0,,Liderliği kazanabilecekler mi?!
Dialogue: 0,0:01:31.11,0:01:32.74,Default,,0,0,0,,İşte orada.
Dialogue: 0,0:01:33.11,0:01:35.99,Default,,0,0,0,,Yüzyılda bir gelen\NUmamusume güzeli...
Dialogue: 0,0:01:36.74,0:01:39.25,Default,,0,0,0,,MARUZENSKY\NAma anlaşılan, O sadece dış görünüşten ibaret değilmiş.
Dialogue: 0,0:01:39.62,0:01:41.96,Default,,0,0,0,,MR. C.B.\NYani, yarış bitene kadar emin olamayız.
Dialogue: 0,0:01:41.96,0:01:43.88,Default,,0,0,0,,Sonuçta bu Japon Derbisi.
Dialogue: 0,0:01:43.88,0:01:45.75,Default,,0,0,0,,SYMBOLI RUDOLF\NBu yarışın son düzlüğü,
Dialogue: 0,0:01:45.75,0:01:47.38,Default,,0,0,0,,bir yarışçıyı sınırlarının ötesine zorlar...
Dialogue: 0,0:01:47.38,0:01:51.63,Default,,0,0,0,,GOLD CITY\NFarkında bile olmadıkları bir potansiyeli açığa çıkarırlar.
Dialogue: 0,0:01:51.97,0:01:53.26,Default,,0,0,0,,Geriye 200 metre kaldı!
Dialogue: 0,0:01:55.64,0:01:56.47,Default,,0,0,0,,Ah!
Dialogue: 0,0:01:56.68,0:01:59.14,Default,,0,0,0,,Başka bir koşucu aniden öne fırladı!
Dialogue: 0,0:01:59.60,0:02:02.14,Default,,0,0,0,,Merry Beauty! Bu Merry Beauty!
Dialogue: 0,0:02:02.14,0:02:04.40,Default,,0,0,0,,{\pos(994,885)}MERRY BEAUTY
Dialogue: 0,0:02:04.73,0:02:06.40,Default,,0,0,0,,Şu güçlü adımlara da bir bakın!
Dialogue: 0,0:02:06.40,0:02:08.73,Default,,0,0,0,,Gold City yetişmek için mücadele ediyor!
Dialogue: 0,0:02:10.40,0:02:12.99,Default,,0,0,0,,Merry Beauty üç boy... hatta şimdi dört boy uzunlukla önde!
Dialogue: 0,0:02:13.03,0:02:16.78,Default,,0,0,0,,O mücadeleye devam ediyor! Luna Swallow onu yakalayabilecek mi?
Dialogue: 0,0:02:16.78,0:02:19.87,Default,,0,0,0,,Dış kulvardan Pyro March takip ediyor!\NDaha da dışarıdan Duel Dagger geliyor!
Dialogue: 0,0:02:19.87,0:02:21.83,Default,,0,0,0,,Gold City! İkinci ise Luna Swallow!
Dialogue: 0,0:02:22.04,0:02:24.08,Default,,0,0,0,,Ve birinci olan Merry Beauty!
Dialogue: 0,0:02:24.54,0:02:26.58,Default,,0,0,0,,Kazananımız Merry Beauty!\NMerry Beauty!
Dialogue: 0,0:02:27.21,0:02:30.96,Default,,0,0,0,,Tam altı boy! Bu çıııılgınca!
Dialogue: 0,0:02:31.30,0:02:32.84,Default,,0,0,0,,Şuna bir bak, Shibasaki!
Dialogue: 0,0:02:32.84,0:02:35.26,Default,,0,0,0,,JO KITAHARA -EĞİTMEN\NO tam altı boy uzunlukla kazandı! Altı boy!
Dialogue: 0,0:02:35.26,0:02:37.72,Default,,0,0,0,,KOICHI SHIBASAKI - EĞİTMEN\NBiraz sakin olur musun, Jo?
Dialogue: 0,0:02:37.72,0:02:41.31,Default,,0,0,0,,Telefondan yarış izlemek yerine,\N önümüzdeki yarışa odaklan.
Dialogue: 0,0:02:42.10,0:02:44.02,Default,,0,0,0,,Oh, hadi ama...
Dialogue: 0,0:02:44.98,0:02:46.98,Default,,0,0,0,,Sanki kıyaslanabilirmiş gibi...
Dialogue: 0,0:02:49.77,0:02:51.90,Default,,0,0,0,,HASHIMA, GIFU İLİ - KASAMATSU YARIŞ PİSTİ
Dialogue: 0,0:02:51.90,0:02:52.65,Default,,0,0,0,,Pekâlâ,
Dialogue: 0,0:02:53.03,0:02:55.32,Default,,0,0,0,,bugünün yarışmacıları piste girdi.
Dialogue: 0,0:02:56.66,0:02:58.32,Default,,0,0,0,,Bekle, onlar yeni ayakkabıların mı?
Dialogue: 0,0:02:58.32,0:03:00.95,Default,,0,0,0,,Yup! Umarım bugün çok kirlenmezler.
Dialogue: 0,0:03:01.37,0:03:03.20,Default,,0,0,0,,Pekala, yarışçılar ''peynir'' diyin!
Dialogue: 0,0:03:03.62,0:03:04.79,Default,,0,0,0,,Peynir!
Dialogue: 0,0:03:04.79,0:03:06.87,Default,,0,0,0,,Bugün çooook güzel koşacağım.
Dialogue: 0,0:03:10.71,0:03:12.51,Default,,0,0,0,,Yapabileceğimiz pek bir şey yok...
Dialogue: 0,0:03:13.13,0:03:17.39,Default,,0,0,0,,Ulusal yarışçılar bölgesel yarışçılardan çok daha ayrı bir seviyede.
Dialogue: 0,0:03:17.59,0:03:20.22,Default,,0,0,0,,Buna tesisler, personeller ve \Nhatta Umamusume'lerde dahil...
Dialogue: 0,0:03:20.43,0:03:22.93,Default,,0,0,0,,İstekliysen hâlâ bölgesel yarışların kendine has cazibesi vardır...
Dialogue: 0,0:03:22.93,0:03:24.60,Default,,0,0,0,,Burada hiç bir yıldız yok.
Dialogue: 0,0:03:25.56,0:03:25.94,Default,,0,0,0,,Pardon?
Dialogue: 0,0:03:27.27,0:03:29.19,Default,,0,0,0,,İnsanların kendilerini görebileceği bir yarışçı...
Dialogue: 0,0:03:29.19,0:03:31.94,Default,,0,0,0,,kalbinin derinliklerinden\Ndesteklemek istediğin biri...
Dialogue: 0,0:03:32.36,0:03:34.32,Default,,0,0,0,,Bir gerçek yıldız.
Dialogue: 0,0:03:44.41,0:03:44.95,Default,,0,0,0,,Oha!
Dialogue: 0,0:03:55.26,0:03:58.22,Default,,0,0,0,,Ne... bu da neydi?
Dialogue: 0,0:05:23.97,0:05:24.97,Default,,0,0,0,,UMAMUSUME
Dialogue: 0,0:05:25.26,0:05:30.23,Default,,0,0,0,,CINDERELLA GRAY
Dialogue: 0,0:05:30.23,0:05:33.35,Default,,0,0,0,,BÖLÜM 1\NBURADAYIM
Dialogue: 0,0:05:59.46,0:06:02.59,Default,,0,0,0,,GİRİŞ TÖRENİ\N GIFU KASAMATSU TRACEN UMAMUSUME EĞİTİM AKADEMİSİ
Dialogue: 0,0:06:02.59,0:06:04.43,Default,,0,0,0,,Bugün başlıyor...
Dialogue: 0,0:06:05.34,0:06:07.30,Default,,0,0,0,,Ben bu akademide mi öğrenciyim!
Dialogue: 0,0:06:10.72,0:06:12.23,Default,,0,0,0,,Joy Maker.
Dialogue: 0,0:06:12.69,0:06:13.73,Default,,0,0,0,,Burda.
Dialogue: 0,0:06:14.02,0:06:15.52,Default,,0,0,0,,South Heroine.
Dialogue: 0,0:06:15.52,0:06:17.69,Default,,0,0,0,,- Yarış okulundaki hayatım sonunda başlıyor!\N- Burda!
Dialogue: 0,0:06:18.23,0:06:21.24,Default,,0,0,0,,Bundan sonra, çok çalışacağım ve çok eğitim yapacağım!
Dialogue: 0,0:06:21.86,0:06:24.03,Default,,0,0,0,,Ve elbet bir gün, bende yarışçı olacağım!
Dialogue: 0,0:06:24.36,0:06:25.61,Default,,0,0,0,,Belno Light.
Dialogue: 0,0:06:26.07,0:06:27.78,Default,,0,0,0,,BELNO LIGHT\NAh, burda!
Dialogue: 0,0:06:27.83,0:06:29.95,Default,,0,0,0,,- Sekai Toha.\N- Burda!
Dialogue: 0,0:06:29.95,0:06:32.45,Default,,0,0,0,,- Yani bunlar benim sınıf arkadaşlarım.\N- Walk Dancer.
Dialogue: 0,0:06:33.05,0:06:34.58,Default,,0,0,0,,- Bahse varım ki hepsi süper hızlıdır... \N- Burda!
Dialogue: 0,0:06:35.21,0:06:36.63,Default,,0,0,0,,Fujimasa March.
Dialogue: 0,0:06:37.13,0:06:37.42,Default,,0,0,0,,Burda.
Dialogue: 0,0:06:38.04,0:06:39.63,Default,,0,0,0,,FUJIMASA MARCH\NFujimasa March!
Dialogue: 0,0:06:40.13,0:06:42.21,Default,,0,0,0,,O bu okulun burslu öğrencisi.
Dialogue: 0,0:06:42.21,0:06:44.09,Default,,0,0,0,,Giriş sınavında en yüksek süreyi o yaptı...
Dialogue: 0,0:06:45.13,0:06:46.59,Default,,0,0,0,,NORN ACE\NNorn Ace.
Dialogue: 0,0:06:46.89,0:06:48.05,Default,,0,0,0,,Burda...
Dialogue: 0,0:06:48.05,0:06:48.47,Default,,0,0,0,,Vay!
Dialogue: 0,0:06:48.47,0:06:50.89,Default,,0,0,0,,Norn Ace burada çok popüler!
Dialogue: 0,0:06:51.22,0:06:52.93,Default,,0,0,0,,Rudy Lemono.
Dialogue: 0,0:06:53.64,0:06:54.77,Default,,0,0,0,,RUDY LEMONO\NEvveeet..
Dialogue: 0,0:06:55.19,0:06:56.98,Default,,0,0,0,,Mini the Lady.
Dialogue: 0,0:06:57.31,0:06:58.40,Default,,0,0,0,,MINI THE LADY\NBurda!
Dialogue: 0,0:06:58.40,0:07:00.73,Default,,0,0,0,,Sanırım nereye gidersen git\Nbaş belaları oluyor...
Dialogue: 0,0:07:00.73,0:07:04.45,Default,,0,0,0,,Ama bu da Kasamatsu Akademisi'nin doğasında var.\NHer bir öğrencinin kendine has tuhaflıkları var...
Dialogue: 0,0:07:12.70,0:07:13.66,Default,,0,0,0,,Phew...
Dialogue: 0,0:07:13.66,0:07:14.41,Default,,0,0,0,,Başardım.
Dialogue: 0,0:07:14.75,0:07:15.87,Default,,0,0,0,,Hayır, geç kaldın.
Dialogue: 0,0:07:16.33,0:07:18.33,Default,,0,0,0,,Tuhaf olanlardan bahsetmişken...
Dialogue: 0,0:07:18.33,0:07:19.63,Default,,0,0,0,,Üniforman nerede?
Dialogue: 0,0:07:19.84,0:07:22.09,Default,,0,0,0,,Hm? Üniforma da ne demek?
Dialogue: 0,0:07:22.11,0:07:23.42,Default,,0,0,0,,Onu bile mi bilmiyorsun?
Dialogue: 0,0:07:23.80,0:07:25.93,Default,,0,0,0,,-Neden spor kıyafetini giyiyor?\N- Üstü de berbat hâlde...
Dialogue: 0,0:07:26.43,0:07:28.22,Default,,0,0,0,,Şimdilik, bir yere otur.
Dialogue: 0,0:07:28.22,0:07:31.56,Default,,0,0,0,,Belno Light'in yanına oturabilirsin.
Dialogue: 0,0:07:31.56,0:07:32.56,Default,,0,0,0,,Bekle, ne?
Dialogue: 0,0:07:33.52,0:07:35.27,Default,,0,0,0,,T-Tanıştığıma memnun oldum...
Dialogue: 0,0:07:37.48,0:07:39.90,Default,,0,0,0,,Bu da ne... \NNeden bana öyle bakıyor...
Dialogue: 0,0:07:39.81,0:07:42.82,Default,,0,0,0,,{\pos(573,256)}YARIŞÇILAR
Dialogue: 0,0:07:40.73,0:07:42.82,Default,,0,0,0,,Pekâlâ, dinleyin, sınıf.
Dialogue: 0,0:07:42.94,0:07:43.82,Default,,0,0,0,,Tanrıya şükür...
Dialogue: 0,0:07:44.74,0:07:49.16,Default,,0,0,0,,Umamusumelerin kendilerine sunulan birçok kariyer yolu vardır.
Dialogue: 0,0:07:49.16,0:07:55.66,Default,,0,0,0,,Kasamatsu Tracen Akademisi yarışçı yetiştirme konusunda uzmanlaşmıştır.
Dialogue: 0,0:07:56.08,0:07:59.63,Default,,0,0,0,,Rehberliğimiz altında koşu becerilerinizi geliştireceksiniz.
Dialogue: 0,0:07:59.63,0:08:03.46,Default,,0,0,0,,Ve en sonunda yarışlara girebileceksiniz.
Dialogue: 0,0:08:03.46,0:08:10.05,Default,,0,0,0,,{\pos(1525,504)}15 PİST
Dialogue: 0,0:08:04.59,0:08:07.26,Default,,0,0,0,,Bölgesel yarışlar
Dialogue: 0,0:08:07.26,0:08:10.05,Default,,0,0,0,,Ülke çapındaki 15 pistte düzenlenir.
Dialogue: 0,0:08:10.05,0:08:11.97,Default,,0,0,0,,Bunlardan siz öğrenciler\Nilk kez yarışa çıkacaksınız.
Dialogue: 0,0:08:11.97,0:08:16.35,Default,,0,0,0,,KASAMATSU\Nburada, kasamatsu yarış pistinde.
Dialogue: 0,0:08:16.60,0:08:18.64,Default,,0,0,0,,Hemen konuya giriyoruz, öyle mi?
Dialogue: 0,0:08:18.69,0:08:20.10,Default,,0,0,0,,Haritası neden bu kadar iyi?!
Dialogue: 0,0:08:20.27,0:08:23.61,Default,,0,0,0,,Eğer başarılı olursanız,
Dialogue: 0,0:08:23.61,0:08:27.32,Default,,0,0,0,,yakınındaki Nagoya Hipodromu'na bile davet edilebilirsiniz.
Dialogue: 0,0:08:27.32,0:08:30.20,Default,,0,0,0,,TOKAI DERBİSİ\NOrada, koşabilirsiniz.
Dialogue: 0,0:08:30.20,0:08:32.37,Default,,0,0,0,,Tokai bölgesinin\Nen prestijli yarışı olan,
Dialogue: 0,0:08:32.37,0:08:33.70,Default,,0,0,0,,Tokai Derbisi.
Dialogue: 0,0:08:34.24,0:08:37.41,Default,,0,0,0,,Sadece birkaç yarışçı bu noktaya kadar gelebiliyor.
Dialogue: 0,0:08:37.45,0:08:38.62,Default,,0,0,0,,Eğer başabilirseniz,
Dialogue: 0,0:08:38.62,0:08:41.79,Default,,0,0,0,,sizi bekleyen tek şey, en yüce şan ve şereftir.
Dialogue: 0,0:08:42.13,0:08:42.75,Default,,0,0,0,,Ne?
Dialogue: 0,0:08:43.29,0:08:45.21,Default,,0,0,0,,Bunlar sadece bölgesel yarışmalar, değil mi?
Dialogue: 0,0:08:45.67,0:08:48.13,Default,,0,0,0,,Ya Twinkle Serisi?
Dialogue: 0,0:08:48.59,0:08:49.47,Default,,0,0,0,,Ah...
Dialogue: 0,0:08:50.43,0:08:53.85,Default,,0,0,0,,Ulusal yarışlar, değil mi?
Dialogue: 0,0:08:54.10,0:08:56.97,Default,,0,0,0,,Yani, bunun hakkında sizin endişelenmenize gerek yok.
Dialogue: 0,0:08:58.35,0:09:01.02,Default,,0,0,0,,Oradaki yarışçılar çok farklı bir seviyede...
Dialogue: 0,0:09:02.60,0:09:04.15,Default,,0,0,0,,Tamamen başka bir seviye...
Dialogue: 0,0:09:04.52,0:09:05.52,Default,,0,0,0,,Pekâlâ.
Dialogue: 0,0:09:06.90,0:09:07.78,Default,,0,0,0,,Kulağa komik geliyor.
Dialogue: 0,0:09:10.40,0:09:11.36,Default,,0,0,0,,Ne diyorsun...
Dialogue: 0,0:09:12.28,0:09:14.12,Default,,0,0,0,,HORLAMA
Dialogue: 0,0:09:14.37,0:09:15.37,Default,,0,0,0,,Bekle, o uyuyor mu?
Dialogue: 0,0:09:16.62,0:09:18.20,Default,,0,0,0,,Sadece uykusunda mı konuşuyordu?
Dialogue: 0,0:09:20.25,0:09:22.21,Default,,0,0,0,,Aah, çok açım!
Dialogue: 0,0:09:22.21,0:09:23.63,Default,,0,0,0,,Bugünün menüsünde ne var?
Dialogue: 0,0:09:26.34,0:09:28.13,Default,,0,0,0,,Bir tane bile arkadaş edinemedim...
Dialogue: 0,0:09:29.34,0:09:32.05,Default,,0,0,0,,Ah... Gerçekten bu kadar içine kapanık olmayı bırakmam gerekiyor.
Dialogue: 0,0:09:32.09,0:09:34.35,Default,,0,0,0,,ve kendimi dışa daha çok göstermem...
Dialogue: 0,0:09:37.31,0:09:38.64,Default,,0,0,0,,O da kendi başına...
Dialogue: 0,0:09:40.27,0:09:42.69,Default,,0,0,0,,Yani, kötü birisine benzemiyor...
Dialogue: 0,0:09:42.69,0:09:46.15,Default,,0,0,0,,Ve az önce kendimi daha fazla dışa göstermem gerektiğini söyledim!
Dialogue: 0,0:09:49.99,0:09:51.07,Default,,0,0,0,,H-Hey sen!
Dialogue: 0,0:09:51.70,0:09:53.32,Default,,0,0,0,,Buraya oturabilir miyim?
Dialogue: 0,0:09:54.99,0:09:55.95,Default,,0,0,0,,Teşekkürler!
Dialogue: 0,0:09:57.08,0:10:00.75,Default,,0,0,0,,TÜM ÜRÜNLER SINIRSIZ!\NKafeteryanın sınırsız yemek konseptine inanabiliyor musun?
Dialogue: 0,0:10:00.75,0:10:03.83,Default,,0,0,0,,Sanırım sağlıklı bir iştah bir,\NUmamusumenin büyümesi için çok önemli!
Dialogue: 0,0:10:05.17,0:10:08.09,Default,,0,0,0,,Hatta kendime iki tam kroket bile aldım...
Dialogue: 0,0:10:10.63,0:10:12.67,Default,,0,0,0,,Şef! Elimizde malzeme kalmadı!
Dialogue: 0,0:10:12.67,0:10:13.97,Default,,0,0,0,,Pirincimiz bitti!
Dialogue: 0,0:10:14.01,0:10:17.22,Default,,0,0,0,,Hangi akıllı sınırsız konsept yapmamızı söyledi... Bekle, ben söyledim!
Dialogue: 0,0:10:17.68,0:10:18.93,Default,,0,0,0,,Hey, şuna bir bak!
Dialogue: 0,0:10:18.93,0:10:21.39,Default,,0,0,0,,- Hah ne...?\N-Hepsini... kendimi yiyecek?
Dialogue: 0,0:10:21.60,0:10:23.98,Default,,0,0,0,,İştahım kaçtı...
Dialogue: 0,0:10:24.35,0:10:26.23,Default,,0,0,0,,Bekle, yanındaki kız...
Dialogue: 0,0:10:29.40,0:10:30.86,Default,,0,0,0,,İmkansız...
Dialogue: 0,0:10:30.86,0:10:32.03,Default,,0,0,0,,Ah, h-hey, bekle!
Dialogue: 0,0:10:32.32,0:10:33.78,Default,,0,0,0,,Benimle arkadaş olmak...
Dialogue: 0,0:10:34.24,0:10:35.57,Default,,0,0,0,,Ah...
Dialogue: 0,0:10:37.78,0:10:38.66,Default,,0,0,0,,2.ci tabak, lütfen.
Dialogue: 0,0:10:38.99,0:10:40.54,Default,,0,0,0,,KAPANDI
Dialogue: 0,0:10:40.87,0:10:41.87,Default,,0,0,0,,Ama nedennn...
Dialogue: 0,0:10:43.29,0:10:46.08,Default,,0,0,0,,Um, eğer hâlâ açsan...
Dialogue: 0,0:10:46.50,0:10:47.37,Default,,0,0,0,,Benimkini alabilirsin.
Dialogue: 0,0:10:47.54,0:10:48.25,Default,,0,0,0,,Alabilir miyim?
Dialogue: 0,0:10:48.96,0:10:50.88,Default,,0,0,0,,Bu kızın nesi var böyle?
Dialogue: 0,0:10:50.88,0:10:52.63,Default,,0,0,0,,Birisi biraz fazla rahat davranıyor.
Dialogue: 0,0:11:08.31,0:11:10.27,Default,,0,0,0,,Hadi gidelim canım! Hava kararıyor!
Dialogue: 0,0:11:10.82,0:11:12.07,Default,,0,0,0,,Geliyorum!
Dialogue: 0,0:11:13.90,0:11:15.53,Default,,0,0,0,,Oh sen... ayakkabılarına bir bak...
Dialogue: 0,0:11:15.61,0:11:16.95,Default,,0,0,0,,Ben küçük bir çim topuyum!
Dialogue: 0,0:11:18.74,0:11:22.62,Default,,0,0,0,,Bekle anne, kaydıraktan bir kez daha kayabilir miyim?
Dialogue: 0,0:11:22.66,0:11:24.25,Default,,0,0,0,,Tamam, sadece bir kere.
Dialogue: 0,0:11:24.25,0:11:26.25,Default,,0,0,0,,Ahaha, yuppi!
Dialogue: 0,0:11:37.09,0:11:40.22,Default,,0,0,0,,KASAMATSU TRACEN AKADEMİSİ YURDU
Dialogue: 0,0:11:45.85,0:11:47.64,Default,,0,0,0,,Hey, Kirli Tavşan...
Dialogue: 0,0:11:47.94,0:11:50.40,Default,,0,0,0,,- Oldukça geç dönüyorsun, değil mi?\N- Nyeheehee...
Dialogue: 0,0:11:50.65,0:11:53.23,Default,,0,0,0,,- Dışarıda ne yapıyordun böyle...\N- Bugün zamanım daha yavaş geçti...
Dialogue: 0,0:11:53.23,0:11:54.61,Default,,0,0,0,,Tempomu mu bozdum?
Dialogue: 0,0:11:55.03,0:11:56.20,Default,,0,0,0,,Düzeltsem iyi olur...
Dialogue: 0,0:11:56.65,0:11:58.24,Default,,0,0,0,,- Ah, iyi akşamlar...\NHey, SEN!
Dialogue: 0,0:11:58.24,0:11:59.41,Default,,0,0,0,,Beni görmezden gelme!
Dialogue: 0,0:11:59.41,0:12:01.99,Default,,0,0,0,,Seninle konuştuğumda, yanıt vereceen, anladıın?
Dialogue: 0,0:12:01.99,0:12:03.58,Default,,0,0,0,,Senin sorunun ne!
Dialogue: 0,0:12:03.62,0:12:05.04,Default,,0,0,0,,- Neler oluyor?\N-Nyeeehehehe!
Dialogue: 0,0:12:05.04,0:12:06.62,Default,,0,0,0,,Hey, kesin şunu!
Dialogue: 0,0:12:06.62,0:12:07.58,Default,,0,0,0,,Kes sesini, bebe.
Dialogue: 0,0:12:07.58,0:12:09.67,Default,,0,0,0,,Kimin konuştuğuna bir bak, Mini!
Dialogue: 0,0:12:11.17,0:12:12.54,Default,,0,0,0,,Oh evet, Kirli Tavşan...
Dialogue: 0,0:12:13.50,0:12:15.59,Default,,0,0,0,,Galiba benim oda arkadaşımsın.
Dialogue: 0,0:12:16.13,0:12:18.30,Default,,0,0,0,,Sorun şu ki, çok fazla valizim var.
Dialogue: 0,0:12:19.34,0:12:21.85,Default,,0,0,0,,Ve çok yer kaplıyorlar...
Dialogue: 0,0:12:23.31,0:12:27.23,Default,,0,0,0,,Bu da senin yatacak yerin olmadığı anlamına geliyor.
Dialogue: 0,0:12:30.02,0:12:32.11,Default,,0,0,0,,DEPO\NYani bunun için üzgünüm,
Dialogue: 0,0:12:32.48,0:12:36.40,Default,,0,0,0,,burada uyuyabileceğini düşünüyor musun...\NKüçük kirli Tavşan?
Dialogue: 0,0:12:36.78,0:12:39.15,Default,,0,0,0,,Depo mu?\NNe yapmaya çalışıyorsunuz...
Dialogue: 0,0:12:42.74,0:12:44.41,Default,,0,0,0,,Neden üzgün olduğunuzu bilmiyorum,
Dialogue: 0,0:12:44.41,0:12:45.79,Default,,0,0,0,,ama kavga etmek kötüdür.
Dialogue: 0,0:12:46.91,0:12:48.46,Default,,0,0,0,,Hadi hep birlikte iyi geçinelim!
Dialogue: 0,0:12:50.83,0:12:53.71,Default,,0,0,0,,Oda konusuda anlaşıldı.\NEşyaları yerleştirirken bol şans.
Dialogue: 0,0:12:54.04,0:12:54.67,Default,,0,0,0,,Görüşürüz.
Dialogue: 0,0:12:57.71,0:12:59.17,Default,,0,0,0,,Onun sorunu ne?
Dialogue: 0,0:12:59.17,0:13:01.39,Default,,0,0,0,,Belki... sadece aptaldır?
Dialogue: 0,0:13:03.01,0:13:04.05,Default,,0,0,0,,Ne büyük bir oyunbozan.
Dialogue: 0,0:13:05.26,0:13:07.27,Default,,0,0,0,,DEPO
Dialogue: 0,0:13:14.23,0:13:16.32,Default,,0,0,0,,Koca oda bana kaldı!
Dialogue: 0,0:13:17.57,0:13:19.15,Default,,0,0,0,,Benim kendi odam!
Dialogue: 0,0:13:20.36,0:13:22.66,Default,,0,0,0,,Ve içinde yumuşacık battaniyeler var! Hatta yastık da!
Dialogue: 0,0:13:23.20,0:13:24.49,Default,,0,0,0,,Elektrik bile var!
Dialogue: 0,0:13:27.66,0:13:30.08,Default,,0,0,0,,Umazing!\NGöz alabildiğince lüks!
Dialogue: 0,0:13:30.46,0:13:31.92,Default,,0,0,0,,Cennette miyim?
Dialogue: 0,0:13:31.92,0:13:38.55,Default,,0,0,0,,{\pos(973,77)}OGURI GÖRÜŞÜ GERÇEKLERDEN FARKLILIK GÖSTEREBİLİR
Dialogue: 0,0:13:32.04,0:13:35.54,Default,,0,0,0,,Yemekler ekstra lezzetli ve üstelik açık büfe!
Dialogue: 0,0:13:35.54,0:13:38.55,Default,,0,0,0,,Ve yeni arkadaşlarım da çok düşünceli!
Dialogue: 0,0:13:38.55,0:13:42.34,Default,,0,0,0,,Kasamatsu Akademisine gelmeme izin verdiğin için çok teşekkürler...
Dialogue: 0,0:13:43.93,0:13:44.64,Default,,0,0,0,,Anne.
Dialogue: 0,0:13:48.85,0:13:49.43,Default,,0,0,0,,TA-DAAA!
Dialogue: 0,0:13:49.43,0:13:50.43,Default,,0,0,0,,Eeee?
Dialogue: 0,0:13:50.43,0:13:52.94,Default,,0,0,0,,Oha! Ne kadar da tatlısın!
Dialogue: 0,0:13:52.94,0:13:54.44,Default,,0,0,0,,Sende çok güzel duruyor!
Dialogue: 0,0:13:55.65,0:13:56.69,Default,,0,0,0,,Ama vay be...
Dialogue: 0,0:13:57.15,0:13:59.36,Default,,0,0,0,,Akademiye gideceğine inanamıyorum.
Dialogue: 0,0:13:59.94,0:14:03.53,Default,,0,0,0,,Sen küçükken, dizlerin yürümek için bile çok zayıftı...
Dialogue: 0,0:14:03.82,0:14:05.53,Default,,0,0,0,,Hepsi senin sayende, anne.
Dialogue: 0,0:14:06.24,0:14:09.66,Default,,0,0,0,,Her gün bana o masajları yaptın.
Dialogue: 0,0:14:11.46,0:14:15.21,Default,,0,0,0,,Ama emin misin? Akademinin çok pahalıya mal olduğunu biliyorum...
Dialogue: 0,0:14:15.21,0:14:16.96,Default,,0,0,0,,Bunun için endişelenme.
Dialogue: 0,0:14:17.21,0:14:20.30,Default,,0,0,0,,Sebze-Meyve harcamalarımızla karşılaştırıldığında, bu sadece bir cep harçlığı.
Dialogue: 0,0:14:20.63,0:14:22.67,Default,,0,0,0,,Bunun hakkında, gerçekten çok üzgünüm...
Dialogue: 0,0:14:22.97,0:14:24.05,Default,,0,0,0,,Üzgün olma.
Dialogue: 0,0:14:24.97,0:14:28.68,Default,,0,0,0,,Yemek yemeyi seven bir çocukta yanlış bir şey yok.
Dialogue: 0,0:14:29.31,0:14:31.68,Default,,0,0,0,,Yiyebileceğin kadar ye,\Nkoşabileceğin kadar koş...
Dialogue: 0,0:14:31.68,0:14:33.94,Default,,0,0,0,,Ve olman gereken Umamusume ol.
Dialogue: 0,0:14:54.71,0:14:56.33,Default,,0,0,0,,Heeheehee...
Dialogue: 0,0:14:57.13,0:15:00.34,Default,,0,0,0,,DEPO\NHeh saat sabahın beşi...
Dialogue: 0,0:15:00.46,0:15:03.59,Default,,0,0,0,,Tabii ki de, bizim küçük Kirli Tavşanımız hâlâ uykuda.
Dialogue: 0,0:15:04.26,0:15:06.01,Default,,0,0,0,,Ama ne yazııık!
Dialogue: 0,0:15:06.01,0:15:09.72,Default,,0,0,0,,Rüyasında bile, benden kaçamayacak!
Dialogue: 0,0:15:10.89,0:15:12.02,Default,,0,0,0,,Peki o zaman... Ahem.
Dialogue: 0,0:15:13.73,0:15:16.98,Default,,0,0,0,,KALK VE PARLA! UYAN!, UYAN! KİRLİ TAVŞAN!
Dialogue: 0,0:15:18.69,0:15:19.98,Default,,0,0,0,,...Ha?
Dialogue: 0,0:15:21.78,0:15:23.78,Default,,0,0,0,,Çoktan valizini toplayıp eve mi gitti?
Dialogue: 0,0:15:25.90,0:15:28.69,Default,,0,0,0,,EĞİTİM PLANI - 5.00 YERİNDE DİZLERİ YÜKSEK TUTARAK KOŞU\N5:10 - ZIPLAYARAK ISINMA
Dialogue: 0,0:15:35.79,0:15:38.04,Default,,0,0,0,,1000 Metre tabelasına ulaştılar!
Dialogue: 0,0:15:39.71,0:15:43.71,Default,,0,0,0,,Bugün kim eve Tokai Derbisi tacını götürecek?
Dialogue: 0,0:15:43.71,0:15:44.80,Default,,0,0,0,,Son kulvardan,
Dialogue: 0,0:15:44.80,0:15:46.84,Default,,0,0,0,,Kitahara Jones geliyor!
Dialogue: 0,0:15:47.01,0:15:48.14,Default,,0,0,0,,Hareketini yapıyor!
Dialogue: 0,0:15:48.55,0:15:51.35,Default,,0,0,0,,Kitahara Jones hızlanıyor! Kitahara Jones...
Dialogue: 0,0:15:51.39,0:15:54.60,Default,,0,0,0,,EVE ALTIN MADALYAYI GÖTÜRÜYOOOOOR!
Dialogue: 0,0:16:00.73,0:16:02.57,Default,,0,0,0,,Keşke şu anda ölsem.
Dialogue: 0,0:16:05.44,0:16:08.28,Default,,0,0,0,,Gri saç... Aynı küle benziyor...
Dialogue: 0,0:16:11.66,0:16:13.91,Default,,0,0,0,,Çok esnek dizleri var.
Dialogue: 0,0:16:22.25,0:16:24.25,Default,,0,0,0,,Yeterince uyuyamadım...
Dialogue: 0,0:16:26.92,0:16:28.01,Default,,0,0,0,,Ah, günaydın!
Dialogue: 0,0:16:28.26,0:16:30.51,Default,,0,0,0,,Dün gece yeterince uyudun mu?
Dialogue: 0,0:16:30.51,0:16:32.47,Default,,0,0,0,,{\pos(970,93)}ŞU ANA KADARKİ EN İYİ UYKU!
Dialogue: 0,0:16:30.51,0:16:32.47,Default,,0,0,0,,Evet, tıpkı bir kaya gibi!
Dialogue: 0,0:16:32.47,0:16:35.06,Default,,0,0,0,,Ne? Bekle, depoda mı?
Dialogue: 0,0:16:35.64,0:16:37.60,Default,,0,0,0,,Pekâlâ, dinleyin!
Dialogue: 0,0:16:38.81,0:16:43.57,Default,,0,0,0,,Ah, bugün sizle kapı ile yarışmanın nasıl işlediğini göstereceğiz.
Dialogue: 0,0:16:43.57,0:16:46.61,Default,,0,0,0,,Toprak pistte 800 metre koşacaksınız.
Dialogue: 0,0:16:46.61,0:16:50.99,Default,,0,0,0,,Çıkış yarışlarınızda da benzer pistlerde koşacaksınız, o yüzden bunu gerçek bir kapışmaymış gibi düşünün.
Dialogue: 0,0:16:51.91,0:16:54.12,Default,,0,0,0,,4 grup hâlinde yarışacaksınız.
Dialogue: 0,0:16:54.58,0:17:00.75,Default,,0,0,0,,Ve hatırlayın ki, kapılar açılana kadar yarış başlamaz.
Dialogue: 0,0:17:00.83,0:17:01.63,Default,,0,0,0,,Hadi oradan.
Dialogue: 0,0:17:01.63,0:17:02.83,Default,,0,0,0,,Salak değiliz.
Dialogue: 0,0:17:03.25,0:17:05.17,Default,,0,0,0,,Oha, bak, bak!
Dialogue: 0,0:17:06.67,0:17:10.18,Default,,0,0,0,,Bahse varım ki onlar antrenörler! Sence bizi izlemeyemi geldiler?
Dialogue: 0,0:17:10.55,0:17:11.93,Default,,0,0,0,,Antişörtler?
Dialogue: 0,0:17:11.93,0:17:13.72,Default,,0,0,0,,Bekle, bilmiyor musun?
Dialogue: 0,0:17:13.72,0:17:18.14,Default,,0,0,0,,EĞİTMENLER UMAMUSUMELERİ İZLER\NEğitmenler bizim yarışmak için yaptığımız eğitimi denetlerler.
Dialogue: 0,0:17:18.14,0:17:23.23,Default,,0,0,0,,{\pos(930,149)}YARIŞLARA GİREBİLMEK İÇİN TAKIMLARINA GİRMEN GEREKİR!
Dialogue: 0,0:17:18.14,0:17:23.23,Default,,0,0,0,,Bir eğitmen tarafından keşfedilip takımlarına katılabilirsen, sen de yarışlara katılabilirsin.
Dialogue: 0,0:17:24.73,0:17:25.73,Default,,0,0,0,,Oh....
Dialogue: 0,0:17:25.73,0:17:26.90,Default,,0,0,0,,İlgisi yok gibi.
Dialogue: 0,0:17:28.36,0:17:31.28,Default,,0,0,0,,Bakalım bu yıl ki acemiler nasılmış bakalım?
Dialogue: 0,0:17:32.36,0:17:34.62,Default,,0,0,0,,Ben Fujimasa March'ı düşünüyorum.
Dialogue: 0,0:17:34.62,0:17:37.37,Default,,0,0,0,,Hey, bekle, onu ilk ben seçtim!
Dialogue: 0,0:17:37.70,0:17:40.25,Default,,0,0,0,,Bekleyin, siz de mi?! Bunu unutun!
Dialogue: 0,0:17:40.25,0:17:42.58,Default,,0,0,0,,Ben ona okula girmeden önce gözümü dikmiştim!
Dialogue: 0,0:17:43.46,0:17:45.96,Default,,0,0,0,,Sonunda bir yıldızın doğuşuna şahit olabilecek miyiz?
Dialogue: 0,0:17:47.84,0:17:48.96,Default,,0,0,0,,Yok ya, sanmam...
Dialogue: 0,0:17:49.97,0:17:51.55,Default,,0,0,0,,Ah, başlıyorlar.
Dialogue: 0,0:17:54.47,0:17:56.39,Default,,0,0,0,,Pekâlâ, yerlerinize...
Dialogue: 0,0:17:59.81,0:18:00.85,Default,,0,0,0,,Hazırlanın...
Dialogue: 0,0:18:01.81,0:18:02.94,Default,,0,0,0,,Başla!
Dialogue: 0,0:18:03.40,0:18:05.44,Default,,0,0,0,,Oh! Ne kadar temiz bir başlangıç!
Dialogue: 0,0:18:05.44,0:18:06.98,Default,,0,0,0,,Formu da keskin derecede!
Dialogue: 0,0:18:06.98,0:18:09.69,Default,,0,0,0,,Onda bir yarışçı\Nkumaşı var, orası kesin!
Dialogue: 0,0:18:10.07,0:18:13.32,Default,,0,0,0,,Bu jenerasyonun belasını bulduk, eh, Jo?
Dialogue: 0,0:18:13.78,0:18:15.07,Default,,0,0,0,,Ha, evet...
Dialogue: 0,0:18:15.07,0:18:16.32,Default,,0,0,0,,O çok güzel.
Dialogue: 0,0:18:30.21,0:18:32.72,Default,,0,0,0,,Süre... 50.8 saniye!
Dialogue: 0,0:18:32.76,0:18:35.18,Default,,0,0,0,,WHOOOA!
Dialogue: 0,0:18:35.26,0:18:36.72,Default,,0,0,0,,Elli saniye!
Dialogue: 0,0:18:36.80,0:18:38.10,Default,,0,0,0,,İşte bu! Onu ben kaptım!
Dialogue: 0,0:18:38.47,0:18:39.81,Default,,0,0,0,,Buraya gel! Bu adil değil!
Dialogue: 0,0:18:40.02,0:18:41.31,Default,,0,0,0,,Bu güç...
Dialogue: 0,0:18:41.77,0:18:44.77,Default,,0,0,0,,Burs almasına şaşmamalı... Çocukta yetenek var.\N- Takımıma katılmak ister misin?
Dialogue: 0,0:18:44.77,0:18:46.10,Default,,0,0,0,,- Hayır bekle, benim takımıma katıl!
Dialogue: 0,0:18:46.10,0:18:47.32,Default,,0,0,0,,{\pos(898,106)}Onları unut! Benim takımıma katıl!
Dialogue: 0,0:18:46.10,0:18:48.27,Default,,0,0,0,,- Söz veriyorum, pişman olmayacaksın!\N- Dersimi bölmez misiniz?
Dialogue: 0,0:18:48.27,0:18:49.73,Default,,0,0,0,,Ama ne önemi var ki?
Dialogue: 0,0:18:51.15,0:18:52.82,Default,,0,0,0,,Zaten benim takımıma katılacak hâli yok ya...
Dialogue: 0,0:18:53.32,0:18:54.53,Default,,0,0,0,,Devam edelim...
Dialogue: 0,0:18:54.53,0:18:55.66,Default,,0,0,0,,Sonraki grup!
Dialogue: 0,0:18:56.20,0:18:58.07,Default,,0,0,0,,Hm...Hm?
Dialogue: 0,0:19:00.95,0:19:02.62,Default,,0,0,0,,O kül saçlı Umamusume,
Dialogue: 0,0:19:02.62,0:19:04.71,Default,,0,0,0,,burada yeni öğrenci mi?
Dialogue: 0,0:19:07.08,0:19:09.00,Default,,0,0,0,,Oha, o gerçekten esnek.
Dialogue: 0,0:19:09.00,0:19:10.55,Default,,0,0,0,,GERİN, GERİN
Dialogue: 0,0:19:11.05,0:19:12.05,Default,,0,0,0,,...Bir dakika bekle.
Dialogue: 0,0:19:12.38,0:19:14.05,Default,,0,0,0,,Biraz fazla esnek değil mi?
Dialogue: 0,0:19:15.26,0:19:16.80,Default,,0,0,0,,Tamam, hadi şunu yapalım!
Dialogue: 0,0:19:16.80,0:19:18.39,Default,,0,0,0,,Uh-huh.
Dialogue: 0,0:19:18.55,0:19:20.56,Default,,0,0,0,,küçük Kirli Tavşan'a kaybetmeyin.
Dialogue: 0,0:19:20.56,0:19:22.22,Default,,0,0,0,,Bunun olmasına imkan yok!
Dialogue: 0,0:19:22.22,0:19:23.35,Default,,0,0,0,,İmkanı yok!
Dialogue: 0,0:19:26.44,0:19:27.94,Default,,0,0,0,,Şimdi ne yapıyorsun?
Dialogue: 0,0:19:29.06,0:19:30.36,Default,,0,0,0,,Heehee!
Dialogue: 0,0:19:30.36,0:19:33.07,Default,,0,0,0,,Yerlerinize... Hazır olun...
Dialogue: 0,0:19:35.53,0:19:36.53,Default,,0,0,0,,Başla!
Dialogue: 0,0:19:37.03,0:19:39.74,Default,,0,0,0,,B-Bekle, ne yapıyorsun?
Dialogue: 0,0:19:40.12,0:19:41.20,Default,,0,0,0,,Bağcıklarım çözülmüş...
Dialogue: 0,0:19:41.20,0:19:41.99,Default,,0,0,0,,Bağcıkların!
Dialogue: 0,0:19:42.04,0:19:43.08,Default,,0,0,0,,Haha!
Dialogue: 0,0:19:43.08,0:19:46.00,Default,,0,0,0,,Kapılara girmeden önce bağcıklarını bağlaman gerekirdi!
Dialogue: 0,0:19:46.21,0:19:49.21,Default,,0,0,0,,Hadi ama! Süremiz azalıyor!
Dialogue: 0,0:19:49.21,0:19:50.29,Default,,0,0,0,,Bu gidişle...
Dialogue: 0,0:19:52.61,0:19:53.81,Default,,0,0,0,,Onları asla yakalayamayacağız...
Dialogue: 0,0:20:00.51,0:20:02.43,Default,,0,0,0,,Heeheehee, ilk sıra benim.
Dialogue: 0,0:20:02.43,0:20:03.60,Default,,0,0,0,,İmkanı yok, o benim!
Dialogue: 0,0:20:10.81,0:20:12.32,Default,,0,0,0,,Ne?
Dialogue: 0,0:20:21.28,0:20:23.74,Default,,0,0,0,,O hızlı! Ama daha önemlisi...
Dialogue: 0,0:20:24.54,0:20:26.54,Default,,0,0,0,,Bu koşuş şeklide ne?
Dialogue: 0,0:20:26.54,0:20:28.62,Default,,0,0,0,,Öne bu kadar eğikken nasıl böyle koşabiliyor?
Dialogue: 0,0:20:29.33,0:20:30.67,Default,,0,0,0,,Omuzlarımı?
Dialogue: 0,0:20:30.67,0:20:31.29,Default,,0,0,0,,Sırtımı?
Dialogue: 0,0:20:32.34,0:20:33.34,Default,,0,0,0,,Hayır...
Dialogue: 0,0:20:34.30,0:20:35.30,Default,,0,0,0,,Dizleri!
Dialogue: 0,0:20:35.59,0:20:38.93,Default,,0,0,0,,İnanılmaz esnekliği o inanılmaz forma olanak sağlıyor!
Dialogue: 0,0:20:39.72,0:20:40.72,Default,,0,0,0,,Haha...
Dialogue: 0,0:20:44.01,0:20:45.39,Default,,0,0,0,,Burada hiçbir yıldız yok.
Dialogue: 0,0:20:48.64,0:20:50.86,Default,,0,0,0,,İnsanların kendilerinden bir şeyler bulabileceği yarışçı...
Dialogue: 0,0:20:51.02,0:20:53.52,Default,,0,0,0,,kalbinin içinden destekleyeceğin birisi...
Dialogue: 0,0:20:58.78,0:20:59.74,Default,,0,0,0,,Sonunda onu buldum...
Dialogue: 0,0:21:02.99,0:21:04.24,Default,,0,0,0,,Sonunda bir yıldız!
Dialogue: 0,0:21:05.74,0:21:08.08,Default,,0,0,0,,Süre... 51.1 saniye!
Dialogue: 0,0:21:09.21,0:21:12.46,Default,,0,0,0,,Bağcıklarımın çözüldüğüne inanamıyorum...
Dialogue: 0,0:21:12.83,0:21:14.13,Default,,0,0,0,,Daha dikkatli olmam gerekli...
Dialogue: 0,0:21:17.46,0:21:19.97,Default,,0,0,0,,B-Bu da ne...
Dialogue: 0,0:21:21.51,0:21:22.76,Default,,0,0,0,,Sende...
Dialogue: 0,0:21:22.76,0:21:23.80,Default,,0,0,0,,Nesin?
Dialogue: 0,0:21:25.01,0:21:25.97,Default,,0,0,0,,H-Hey, hey!
Dialogue: 0,0:21:25.97,0:21:27.64,Default,,0,0,0,,B-B-Bir dakika bekle!
Dialogue: 0,0:21:30.56,0:21:31.64,Default,,0,0,0,,Ah, bu Kitahara Jones.
Dialogue: 0,0:21:31.64,0:21:33.10,Default,,0,0,0,,Lütfen bunu unutur musun?
Dialogue: 0,0:21:33.56,0:21:35.32,Default,,0,0,0,,Sen! Adın ne?
Dialogue: 0,0:21:44.37,0:21:45.12,Default,,0,0,0,,Oguri Cap.
Dialogue: 0,0:21:46.91,0:21:49.83,Default,,0,0,0,,"Cap"... Yani "zirve"...
Dialogue: 0,0:21:46.91,0:21:49.83,Default,,0,0,0,,{\pos(191.2,20.933)}(ÇN: Oguri Peak yani.)
Dialogue: 0,0:21:51.87,0:21:52.83,Default,,0,0,0,,Bu senin için çok iyi!
Dialogue: 0,0:21:56.29,0:21:58.30,Default,,0,0,0,,Adım Kitahara Jo!
Dialogue: 0,0:21:59.05,0:22:02.09,Default,,0,0,0,,Benimle dünyayı fethetmeye ne dersin, Oguri Cap?
Dialogue: 0,0:22:03.26,0:22:06.26,Default,,0,0,0,,OGURI CAP
Dialogue: 0,0:23:36.27,0:23:39.36,Default,,0,0,0,,BÖLÜM 2\NYARIŞMAMA İZİN VER
Dialogue: 0,0:23:39.36,0:23:42.32,Default,,0,0,0,,Umamusume: Cinderella Gray'de sonraki bölümde!
Dialogue: 0,0:23:42.40,0:23:45.45,Default,,0,0,0,,Bölüm 2 - Yarışmama İzin Ver
