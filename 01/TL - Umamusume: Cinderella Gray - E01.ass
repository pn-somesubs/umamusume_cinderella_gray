Dialogue: 0,0:00:00.00,0:00:10.00,Default,,0,0,0,,{\fs50\an7\fe162\b\fad(400,400)\bord2\blur5\shad\4c&H000000&\4a&HFF&\fnSweetest Cat Ever}\N{\pos(20,-2)}{\c&HFFFF00&}{\4c&H8485E4&}SomeSub ekip arkadaşı arıyor!\N{\pos(60,63)}{\c&HFFFFFF&}Çevirmen:{\c&HFFFF00&} Mythos\N{\pos(60,111)}{\c&HFFFFFF&}Encode:{\c&HFFFF00&} Velnoxy\N{\pos(60,111)}{\c&HFFFFFF&}Redaktör:{\c&HFFFF00&} Myopie\N{\c&HFFFFFF&}Discord:{\c&HFFFF00&} discord.gg/somesub
Dialogue: 0,0:00:01.23,0:00:03.42,Default,,0,0,0,,Yarışçılar son düzlüğe girdi!
Dialogue: 0,0:00:04.73,0:00:07.61,Default,,0,0,0,,Kaçan Fujimasa March \N Onu kovalayan Oguri Cap.
Dialogue: 0,0:00:08.72,0:00:09.91,Default,,0,0,0,,Her şey son ana kaldı.
Dialogue: 0,0:00:10.41,0:00:13.78,Default,,0,0,0,,Benim hedefim Tokai Derbisi şampiyonluğu.
Dialogue: 0,0:00:14.27,0:00:15.91,Default,,0,0,0,,Sanki bu seviyedeki bir yarışta...
Dialogue: 0,0:00:17.50,0:00:19.54,Default,,0,0,0,,Nasıl kaybedebilirim?!
Dialogue: 0,0:00:19.54,0:00:20.99,Default,,0,0,0,,Fujimasa March,
Dialogue: 0,0:00:20.99,0:00:22.79,Default,,0,0,0,,hızını daha da artırıyor!
Dialogue: 0,0:00:29.48,0:00:31.97,Default,,0,0,0,,Fakat Oguri Cap, ısrarcı takibini sürdürüyor.
Dialogue: 0,0:00:32.87,0:00:34.22,Default,,0,0,0,,Son 100 metre!
Dialogue: 0,0:00:37.04,0:00:38.31,Default,,0,0,0,,Burada kaybedemem!
Dialogue: 0,0:00:39.06,0:00:40.61,Default,,0,0,0,,Kaybetmeyeceğim!
Dialogue: 0,0:00:50.21,0:00:51.11,Default,,0,0,0,,İşte bu, millet!
Dialogue: 0,0:00:55.73,0:00:58.25,Default,,0,0,0,,Sonuç kesinleşti!
Dialogue: 0,0:00:58.25,0:01:01.25,Default,,0,0,0,,[Boyun farkıyla] [Onaylandı]
Dialogue: 0,0:01:01.30,0:01:03.42,Default,,0,0,0,,Birinci Fujimasa March!
Dialogue: 0,0:01:03.74,0:01:04.88,Default,,0,0,0,,İkinci Oguri Cap!
Dialogue: 0,0:01:05.10,0:01:06.38,Default,,0,0,0,,-Üçüncü Sout Heroine...
Dialogue: 0,0:01:06.38,0:01:08.34,Default,,0,0,0,,-March cidden harika!\N- Dördüncü Sekai Toha.
Dialogue: 0,0:01:08.56,0:01:11.26,Default,,0,0,0,,- Pis tavşan. Beni bir an korkuttu.
Dialogue: 0,0:01:17.23,0:01:18.52,Default,,0,0,0,,Seni...
Dialogue: 0,0:01:19.64,0:01:22.19,Default,,0,0,0,,Oh... Kıl payı!
Dialogue: 0,0:01:22.46,0:01:23.63,Default,,0,0,0,,Fakat kazandık.
Dialogue: 0,0:01:27.17,0:01:30.32,Default,,0,0,0,,Böyle biteceğini sanma, Shibasaki!
Dialogue: 0,0:01:30.40,0:01:31.54,Default,,0,0,0,,Sonraki sefer biz kazanacağız!
Dialogue: 0,0:01:31.54,0:01:33.28,Default,,0,0,0,,Ezikliği takdire şayan..
Dialogue: 0,0:01:41.65,0:01:42.65,Default,,0,0,0,,Oguri-chan!
Dialogue: 0,0:01:44.59,0:01:45.59,Default,,0,0,0,,Belno...
Dialogue: 0,0:01:47.00,0:01:50.09,Default,,0,0,0,,Oguri-chan, yarışta \Nbiraz garip görünüyordun.
Dialogue: 0,0:01:50.18,0:01:51.38,Default,,0,0,0,,İyi misi—
Dialogue: 0,0:01:51.57,0:01:53.43,Default,,0,0,0,,Bekle, kan mı?!
Dialogue: 0,0:01:54.40,0:01:58.06,Default,,0,0,0,,Of! Yumruklarını bu kadar sıkma!
Dialogue: 0,0:01:58.06,0:02:00.14,Default,,0,0,0,,Kendine zarar verecek şeyler yapmamalısın!
Dialogue: 0,0:02:00.60,0:02:02.64,Default,,0,0,0,,Sinirlenmeni anlıyorum, ama!
Dialogue: 0,0:02:05.75,0:02:06.47,Default,,0,0,0,,Demek...
Dialogue: 0,0:02:08.45,0:02:11.12,Default,,0,0,0,,Ben... sinirlenmişim.
Dialogue: 0,0:02:12.35,0:02:15.05,Default,,0,0,0,,O bir yana, Oguri-chan, o ayakkabılar...
Dialogue: 0,0:02:16.22,0:02:18.05,Default,,0,0,0,,Bu ayakkabılarla mı koştun?
Dialogue: 0,0:02:18.62,0:02:19.00,Default,,0,0,0,,Evet.
Dialogue: 0,0:02:19.82,0:02:20.67,Default,,0,0,0,,Yoksa,
Dialogue: 0,0:02:20.67,0:02:23.29,Default,,0,0,0,,Kum tekmeleme antrenmanın yüzünden mi?
Dialogue: 0,0:02:23.59,0:02:24.42,Default,,0,0,0,,Evet...
Dialogue: 0,0:02:25.06,0:02:27.56,Default,,0,0,0,,Bu yarış için dayanırlar sanmıştım.
Dialogue: 0,0:02:28.25,0:02:30.17,Default,,0,0,0,,AAAAAH!
Dialogue: 0,0:02:30.65,0:02:32.38,Default,,0,0,0,,Kaybettim!
Dialogue: 0,0:02:32.38,0:02:34.19,Default,,0,0,0,,Ah... geçti, geçti...
Dialogue: 0,0:02:35.63,0:02:37.46,Default,,0,0,0,,Koşmayı seviyorum ama..
Dialogue: 0,0:02:40.94,0:02:43.16,Default,,0,0,0,,kaybetmek çok sinir bozucu.
Dialogue: 0,0:02:47.81,0:02:49.31,Default,,0,0,0,,Ne? Bu ne böyle?
Dialogue: 0,0:02:49.91,0:02:53.23,Default,,0,0,0,,O mu? Daha deminki yarışta ikinci olan,
Dialogue: 0,0:02:53.23,0:02:54.86,Default,,0,0,0,,Umamusume'nin ayak iziymiş.
Dialogue: 0,0:02:54.86,0:02:56.66,Default,,0,0,0,,Bu adeta.
Dialogue: 0,0:02:57.50,0:02:59.59,Default,,0,0,0,,Bir canavarın ayak izi.
Dialogue: 0,0:04:24.49,0:04:25.66,Default,,0,0,0,,UMAMUSUME
Dialogue: 0,0:04:25.95,0:04:31.00,Default,,0,0,0,,CINDERELLA GRAY
Dialogue: 0,0:04:31.00,0:04:32.50,Default,,0,0,0,,MÜDÜR
Dialogue: 0,0:04:32.76,0:04:34.50,Default,,0,0,0,,Tebrik ederim!
Dialogue: 0,0:04:34.50,0:04:37.78,Default,,0,0,0,,İlk yarışın için harika bir yarıştı.
Dialogue: 0,0:04:37.78,0:04:39.43,Default,,0,0,0,,Fujimasa March!
Dialogue: 0,0:04:37.78,0:04:39.43,Default,,0,0,0,,{\pos(1584,912)\fs59}BÖLÜM 3
Dialogue: 0,0:04:37.78,0:04:39.43,Default,,0,0,0,,{\fs59\pos(1584,954)}Zirvenin manzarası
Dialogue: 0,0:04:39.43,0:04:41.76,Default,,0,0,0,,Senden büyük şeyler bekliyorum.
Dialogue: 0,0:04:42.12,0:04:45.84,Default,,0,0,0,,Ve Shibasaki-kun, daha genç olmana rağmen oldukça iyi iş çıkarıyorsun.
Dialogue: 0,0:04:45.98,0:04:47.01,Default,,0,0,0,,Onur duydum efendim.
Dialogue: 0,0:04:47.43,0:04:49.73,Default,,0,0,0,,İleride hangi yarışları hedefliyorsunuz?
Dialogue: 0,0:04:50.19,0:04:53.06,Default,,0,0,0,,Sanırım sıradaki hedefiniz Chukyo Hai olur.
Dialogue: 0,0:04:53.22,0:04:54.70,Default,,0,0,0,,Hayır, daha karar verm—
Dialogue: 0,0:04:55.41,0:04:57.86,Default,,0,0,0,,Hedefimiz Tokai Derbisi.
Dialogue: 0,0:04:58.23,0:04:58.92,Default,,0,0,0,,Vay!
Dialogue: 0,0:04:58.92,0:04:59.91,Default,,0,0,0,,Bekle, March—
Dialogue: 0,0:05:00.28,0:05:01.45,Default,,0,0,0,,Fakat, bu...
Dialogue: 0,0:05:02.33,0:05:04.26,Default,,0,0,0,,Oguri Cap'ı yendikten sonra olacak.
Dialogue: 0,0:05:04.92,0:05:07.28,Default,,0,0,0,,Ha? Ne demek istiyorsun?
Dialogue: 0,0:05:07.28,0:05:09.00,Default,,0,0,0,,Çoktan yendin ya.
Dialogue: 0,0:05:14.84,0:05:16.71,Default,,0,0,0,,Vaaay!
Dialogue: 0,0:05:17.46,0:05:19.71,Default,,0,0,0,,Ne kadar çok mağaza var!
Dialogue: 0,0:05:19.71,0:05:22.06,Default,,0,0,0,,Bir de parıl parıl parlıyorlar..
Dialogue: 0,0:05:22.32,0:05:24.24,Default,,0,0,0,,Demek bahsettikleri o büyük şehir burası?!
Dialogue: 0,0:05:24.33,0:05:26.22,Default,,0,0,0,,Yok, sadece buradaki alışveriş merkezi.
Dialogue: 0,0:05:32.81,0:05:34.00,Default,,0,0,0,,B-Belno!
Dialogue: 0,0:05:34.00,0:05:35.77,Default,,0,0,0,,Lezzetli görünen bir sürü şey var!
Dialogue: 0,0:05:36.09,0:05:37.57,Default,,0,0,0,,Onları yemeye mi geldik?!
Dialogue: 0,0:05:37.80,0:05:38.97,Default,,0,0,0,,Ne? Hayır.
Dialogue: 0,0:05:41.91,0:05:43.77,Default,,0,0,0,,Şey... Oguri-chan.
Dialogue: 0,0:05:44.36,0:05:45.30,Default,,0,0,0,,Buraya geldik çünkü...
Dialogue: 0,0:05:46.59,0:05:48.12,Default,,0,0,0,,Ayakkabı mı?
Dialogue: 0,0:05:48.57,0:05:51.46,Default,,0,0,0,,Evet. Seni yalnız başına gönderirsem,
Dialogue: 0,0:05:51.46,0:05:53.29,Default,,0,0,0,,ne alacağını bileceğini sanmıyorum.
Dialogue: 0,0:05:53.61,0:05:55.71,Default,,0,0,0,,Sen de ona eşlik eder misin?
Dialogue: 0,0:05:55.88,0:05:56.48,Default,,0,0,0,,Kes şunu.
Dialogue: 0,0:05:57.17,0:05:58.83,Default,,0,0,0,,Al bakalım,ayakkabı için.
Dialogue: 0,0:05:58.83,0:05:59.58,Default,,0,0,0,,Ah...
Dialogue: 0,0:06:00.46,0:06:02.91,Default,,0,0,0,,Benim için sakıncası yok ama,
Dialogue: 0,0:06:03.43,0:06:05.43,Default,,0,0,0,,bunun yeterli olacağını sanmıyorum.
Dialogue: 0,0:06:05.82,0:06:06.48,Default,,0,0,0,,Ne?
Dialogue: 0,0:06:06.48,0:06:09.72,Default,,0,0,0,,Oguri-chan koşarken \Nyere çok baskı uyguluyor.
Dialogue: 0,0:06:09.72,0:06:10.94,Default,,0,0,0,,Yani normal bir ayakkabı alırsak.
Dialogue: 0,0:06:10.94,0:06:12.97,Default,,0,0,0,,Kısa sürede kullanılmaz hale gelir.
Dialogue: 0,0:06:13.41,0:06:16.42,Default,,0,0,0,,Biraz pahalı olsa da\N sağlam bir çift alsak daha iyi olur.
Dialogue: 0,0:06:16.71,0:06:19.20,Default,,0,0,0,,H-Haklısın...
Dialogue: 0,0:06:19.50,0:06:21.22,Default,,0,0,0,,Üstelik nallar da zamanla,
Dialogue: 0,0:06:21.22,0:06:23.91,Default,,0,0,0,,yıpranabileceği için birkaç çift almak mantıklı olur.
Dialogue: 0,0:06:24.09,0:06:25.32,Default,,0,0,0,,- Oh, bir kelebek.\NT-Tamam, anladım.
Dialogue: 0,0:06:25.78,0:06:28.05,Default,,0,0,0,,Kartı vereceğim neye ihtiyacınız varsa alın!
Dialogue: 0,0:06:29.46,0:06:31.77,Default,,0,0,0,,O yüzden,\Nhızlıca ayakkabı alma—
Dialogue: 0,0:06:31.91,0:06:33.75,Default,,0,0,0,,{\an8}Guruldama
Dialogue: 0,0:06:35.28,0:06:37.42,Default,,0,0,0,,Gitmeden önce. yemek yiyelim.
Dialogue: 0,0:06:38.00,0:06:38.76,Default,,0,0,0,,Emin misin?
Dialogue: 0,0:06:45.42,0:06:46.68,Default,,0,0,0,,Burası!
Dialogue: 0,0:06:48.26,0:06:49.70,Default,,0,0,0,,Sana güzel bir ayakkabı bulalım!
Dialogue: 0,0:06:51.63,0:06:53.13,Default,,0,0,0,,Ne çok çeşit var...
Dialogue: 0,0:07:00.07,0:07:00.85,Default,,0,0,0,,Çok şirinler...
Dialogue: 0,0:07:01.59,0:07:03.46,Default,,0,0,0,,Oguri-chan, Oguri-chan!
Dialogue: 0,0:07:03.96,0:07:05.94,Default,,0,0,0,,Tam sana yakışacak bir çift buldum!
Dialogue: 0,0:07:06.57,0:07:07.61,Default,,0,0,0,,Buna ne dersin?
Dialogue: 0,0:07:08.20,0:07:08.85,Default,,0,0,0,,MUTSUZ
Dialogue: 0,0:07:08.85,0:07:10.87,Default,,0,0,0,,Su geçirmez, kaymaya dirençli,
Dialogue: 0,0:07:10.87,0:07:12.75,Default,,0,0,0,,Ekstra güçlü lifli bir reçineyle güçlendirilmiş!
Dialogue: 0,0:07:12.75,0:07:14.62,Default,,0,0,0,,Bunlar önceki çift gibi parçalanmaz.
Dialogue: 0,0:07:15.37,0:07:19.72,Default,,0,0,0,,Şeyy... evet dayanıklı gözüküyorlar...
Dialogue: 0,0:07:20.11,0:07:23.26,Default,,0,0,0,,O zaman anlaştık.\NŞimdi de birkaç nal seçelim...
Dialogue: 0,0:07:23.26,0:07:25.78,Default,,0,0,0,,Antrenman için ağır olsa da uzun ömürlü, düşük karbonlu çelik standarttır.
Dialogue: 0,0:07:25.78,0:07:27.85,Default,,0,0,0,,Yarışlar içinse bu alüminyum alaşımını öneririm!\NÇelik olanların en az üçte biri ağırlığında!
Dialogue: 0,0:07:27.85,0:07:29.35,Default,,0,0,0,,Fakat çelik kadar dayanıklı değiller, o yüzden birkaç tane alalım!
Dialogue: 0,0:07:32.44,0:07:33.93,Default,,0,0,0,,Ne dersin, Oguri-chan?
Dialogue: 0,0:07:34.67,0:07:36.44,Default,,0,0,0,,Hm, nasıl desem...
Dialogue: 0,0:07:36.69,0:07:39.28,Default,,0,0,0,,Baya bilgilisin.\NBir uzman gibisin.
Dialogue: 0,0:07:39.91,0:07:41.52,Default,,0,0,0,,Aslında ailem.
Dialogue: 0,0:07:41.52,0:07:44.44,Default,,0,0,0,,Umamusume'lere özel spor malzemeleri satan bir mağaza zinciri işletiyor.
Dialogue: 0,0:07:44.76,0:07:47.88,Default,,0,0,0,,Küçüklüğümden beri gördüğüm için \Nbiraz biliyorum...
Dialogue: 0,0:07:47.88,0:07:51.28,Default,,0,0,0,,Ama bunun sayesinde sana \Nyardım edebildiğime sevindim.
Dialogue: 0,0:07:55.33,0:07:55.91,Default,,0,0,0,,Evet...
Dialogue: 0,0:07:57.89,0:07:59.54,Default,,0,0,0,,Artık kaybedemem.
Dialogue: 0,0:08:02.17,0:08:03.49,Default,,0,0,0,,Bir dahakine kazanacağım!
Dialogue: 0,0:08:05.21,0:08:07.63,Default,,0,0,0,,{\pos(906,168)}İKİ HAFTA SONRA...\NKASAMATSU YARIŞ PİSTİ
Dialogue: 0,0:08:07.63,0:08:10.14,Default,,0,0,0,,ALIŞVERİŞİNİZ İÇİN TEŞEKKÜR EDERİZ.
Dialogue: 0,0:08:12.13,0:08:13.47,Default,,0,0,0,,Ah, Jo-san, bir şey mi oldu?
Dialogue: 0,0:08:13.49,0:08:14.72,Default,,0,0,0,,Sadece küçük bir iş masrafı.
Dialogue: 0,0:08:15.58,0:08:17.35,Default,,0,0,0,,Lütfen kazan...
Dialogue: 0,0:08:18.37,0:08:19.81,Default,,0,0,0,,İki numaralı kulvar, South Heroine!
Dialogue: 0,0:08:20.15,0:08:21.23,Default,,0,0,0,,Koşmaya hazır gözüküyor!
Dialogue: 0,0:08:21.69,0:08:24.31,Default,,0,0,0,,– Ayağının durumu neredeyse mükemmel...\N– Bugün harika bir yarış izleyeceğiz.
Dialogue: 0,0:08:24.31,0:08:26.99,Default,,0,0,0,,Bu yarış da, önceki yarışla\N aynı şekilde, 800 metre.
Dialogue: 0,0:08:27.28,0:08:29.70,Default,,0,0,0,,Güzel bir başlangıç yaptığı sürece\N sorun olmamalı.
Dialogue: 0,0:08:30.15,0:08:33.20,Default,,0,0,0,,Üstelik bu sefer Fujimasa March-san yok.
Dialogue: 0,0:08:33.77,0:08:35.54,Default,,0,0,0,,Beni endişelendiren tek şey...
Dialogue: 0,0:08:36.11,0:08:37.11,Default,,0,0,0,,Ne?
Dialogue: 0,0:08:37.45,0:08:38.97,Default,,0,0,0,,Merak etme dedim ya!
Dialogue: 0,0:08:39.25,0:08:41.29,Default,,0,0,0,,Çantada keklik olacak.
Dialogue: 0,0:08:41.61,0:08:44.13,Default,,0,0,0,,Şu pis tavşana nasıl kaybedebilirim ki?
Dialogue: 0,0:08:44.51,0:08:46.06,Default,,0,0,0,,Siz değilim sonuçta.
Dialogue: 0,0:08:46.09,0:08:49.03,Default,,0,0,0,,O resmi yarış değildi\Nsayılmaz!
Dialogue: 0,0:08:49.61,0:08:50.81,Default,,0,0,0,,Norn Ace-san...
Dialogue: 0,0:08:51.11,0:08:53.65,Default,,0,0,0,,Onunla karşılaşacağımızı\N hiç düşünmemiştim...
Dialogue: 0,0:08:54.26,0:08:56.21,Default,,0,0,0,,Umarım bir şey olmaz...
Dialogue: 0,0:08:56.74,0:08:58.02,Default,,0,0,0,,Norn! Norn!
Dialogue: 0,0:08:58.02,0:08:59.13,Default,,0,0,0,,Hm?
Dialogue: 0,0:08:59.13,0:09:00.15,Default,,0,0,0,,Ne var, Mini?
Dialogue: 0,0:09:00.87,0:09:03.39,Default,,0,0,0,,Ondan sonra... yap...
Dialogue: 0,0:09:04.35,0:09:05.61,Default,,0,0,0,,Aha...
Dialogue: 0,0:09:06.59,0:09:07.77,Default,,0,0,0,,İyi...
Dialogue: 0,0:09:07.86,0:09:08.86,Default,,0,0,0,,Fikirmiş.
Dialogue: 0,0:09:10.35,0:09:12.03,Default,,0,0,0,,800 metrelik bu yarışta,
Dialogue: 0,0:09:12.41,0:09:15.37,Default,,0,0,0,,Kasamatsu'ya bağlı sekiz yarışçı yarışacak.
Dialogue: 0,0:09:20.94,0:09:23.64,Default,,0,0,0,,Tüm yarışçılar yerlerini aldı.
Dialogue: 0,0:09:26.67,0:09:27.87,Default,,0,0,0,,Hazırlıklar tamamlandı!
Dialogue: 0,0:09:28.22,0:09:29.55,Default,,0,0,0,,Hadi yaparsın!
Dialogue: 0,0:09:32.22,0:09:33.30,Default,,0,0,0,,Ve çıkış yaptılar!
Dialogue: 0,0:09:34.01,0:09:36.01,Default,,0,0,0,,Sekiz yarışmacı da güzel bir başlangıç yaptı!
Dialogue: 0,0:09:36.27,0:09:37.53,Default,,0,0,0,,Güzel! İyi başladı!
Dialogue: 0,0:09:37.77,0:09:38.47,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:09:39.36,0:09:41.46,Default,,0,0,0,, Norn Ace dış kulvardan \Niç kulvara yöneliyor.
Dialogue: 0,0:09:41.46,0:09:43.17,Default,,0,0,0,,Ve iyi bir pozisyona yerleşiyor.
Dialogue: 0,0:09:43.73,0:09:46.32,Default,,0,0,0,,Hehe, işte böyle.\NHer şey plana göre gidiyor.
Dialogue: 0,0:09:46.74,0:09:47.79,Default,,0,0,0,,Neyden bahsediyorsun?
Dialogue: 0,0:09:48.51,0:09:52.32,Default,,0,0,0,,Pis Tavşan son atağına geçmeden \Nhemen önce topuğuna bas.
Dialogue: 0,0:09:53.07,0:09:58.20,Default,,0,0,0,,Son atağına geçmeden önce hep \Nayağını yere sertçe basar.
Dialogue: 0,0:09:58.20,0:10:01.21,Default,,0,0,0,,Yani Norn'un yapacağı tek şey, Pis tavşa'nın topuğuna dokunmak.
Dialogue: 0,0:10:01.21,0:10:04.08,Default,,0,0,0,,Uzaktan bakınca sadece\N basit bir kaza gibi görünecek.
Dialogue: 0,0:10:04.08,0:10:09.24,Default,,0,0,0,,Numaranın işe yaramasını istiyorsan, gerçekten önemli olan zamanlamayı tutturmak..
Dialogue: 0,0:10:09.24,0:10:10.38,Default,,0,0,0,,Cidden fenasın.
Dialogue: 0,0:10:10.98,0:10:13.65,Default,,0,0,0,,Yeni ayakkabı falan almış olabilir ama..
Dialogue: 0,0:10:14.07,0:10:15.99,Default,,0,0,0,,Eğer çıkarsalar\Nbir anlamı kalmaz değil mi?
Dialogue: 0,0:10:16.46,0:10:18.97,Default,,0,0,0,,İlerideki grup üçüncü virajı geçti, \Ndördüncü viraja ilerliyor.
Dialogue: 0,0:10:18.97,0:10:20.51,Default,,0,0,0,,İlk sırada iki numara, South Heroine,
Dialogue: 0,0:10:20.51,0:10:23.89,Default,,0,0,0,,{\an8}-Peşindeyse 1 numaralı Oguri Cap.
Dialogue: 0,0:10:20.51,0:10:23.89,Default,,0,0,0,,- O aptal bir şeyler karıştırıyor...
Dialogue: 0,0:10:23.89,0:10:24.69,Default,,0,0,0,,Ne?
Dialogue: 0,0:10:25.71,0:10:27.77,Default,,0,0,0,,İlk önce arkasına geçeyim...
Dialogue: 0,0:10:34.50,0:10:36.30,Default,,0,0,0,,Öndeki grup son düzlükte!
Dialogue: 0,0:10:36.62,0:10:37.82,Default,,0,0,0,,Son 200 metre!
Dialogue: 0,0:10:38.50,0:10:42.72,Default,,0,0,0,,Oguri Cap ikinci sırada, Norn Ace hemen arkasında sıkı takibini sürdürüyor!
Dialogue: 0,0:10:43.95,0:10:44.74,Default,,0,0,0,,Sinirimi bozuyorsun...
Dialogue: 0,0:10:46.05,0:10:48.75,Default,,0,0,0,,Ezik olmana rağmen,\NGöz önünde olmaya çalışıyorsun.
Dialogue: 0,0:10:48.78,0:10:52.62,Default,,0,0,0,,March'ı neredeyse yendin diye \Nhemen havalanma.
Dialogue: 0,0:10:55.19,0:10:56.70,Default,,0,0,0,,Zirvede kalabilecekler...
Dialogue: 0,0:11:00.29,0:11:01.93,Default,,0,0,0,,Sadece özel yeteneklilerdir.
Dialogue: 0,0:11:02.85,0:11:03.64,Default,,0,0,0,,O zaman.
Dialogue: 0,0:11:03.83,0:11:07.16,Default,,0,0,0,,Gerçeği kabullenip\Nsadece eğlenmek daha akıllıca değil mi.
Dialogue: 0,0:11:08.27,0:11:11.15,Default,,0,0,0,,Memleketime göre hızlıyım.\Nbu benim için yeterli.
Dialogue: 0,0:11:11.69,0:11:13.61,Default,,0,0,0,,Kirlenip ter içinde kalmanın...
Dialogue: 0,0:11:14.01,0:11:15.30,Default,,0,0,0,,Bana ne gibi bir yararı olacak?
Dialogue: 0,0:11:15.73,0:11:17.49,Default,,0,0,0,,Bu sadece ezikçe.
Dialogue: 0,0:11:21.74,0:11:23.25,Default,,0,0,0,,İşte bu yüzden...
Dialogue: 0,0:11:24.27,0:11:25.34,Default,,0,0,0,,Sinirimi bozuyorsun!
Dialogue: 0,0:11:30.32,0:11:32.63,Default,,0,0,0,,Buradan defol!
Dialogue: 0,0:11:40.67,0:11:42.31,Default,,0,0,0,,Oguri Cap son atağına başlıyor!
Dialogue: 0,0:11:42.31,0:11:44.68,Default,,0,0,0,,South Heroine'ı hızla geçip \Nliderliği alıyor!
Dialogue: 0,0:11:46.25,0:11:47.02,Default,,0,0,0,,Seni—
Dialogue: 0,0:11:51.70,0:11:53.53,Default,,0,0,0,,Şimdiden o kadar uzakta mı?
Dialogue: 0,0:11:54.51,0:11:55.51,Default,,0,0,0,,Olamaz...
Dialogue: 0,0:11:56.20,0:11:57.20,Default,,0,0,0,,Böyle bir şey...
Dialogue: 0,0:11:57.90,0:11:59.11,Default,,0,0,0,,Kazanmamın imkanı yok...
Dialogue: 0,0:12:01.03,0:12:02.03,Default,,0,0,0,,Harika...
Dialogue: 0,0:12:04.42,0:12:05.42,Default,,0,0,0,,Bitiş çizgisi!
Dialogue: 0,0:12:07.30,0:12:10.58,Default,,0,0,0,,Oguri Cap rakiplerini ezip geçerek\N rahatça birinciliği alıyor!
Dialogue: 0,0:12:11.25,0:12:13.71,Default,,0,0,0,,İkinci yarışında ilk galibiyetini alıyor!
Dialogue: 0,0:12:13.90,0:12:14.90,Default,,0,0,0,,İşte bu!
Dialogue: 0,0:12:14.90,0:12:15.92,Default,,0,0,0,,Çok şükür!
Dialogue: 0,0:12:17.35,0:12:19.03,Default,,0,0,0,,Yok artık, ciddi misin?
Dialogue: 0,0:12:22.63,0:12:23.63,Default,,0,0,0,,Üzgünüm.
Dialogue: 0,0:12:25.38,0:12:27.33,Default,,0,0,0,,Yüzüne kum fırlatmak istememiştim.
Dialogue: 0,0:12:27.83,0:12:28.83,Default,,0,0,0,,İyi misin?
Dialogue: 0,0:12:32.53,0:12:33.10,Default,,0,0,0,,Endişelenme.
Dialogue: 0,0:12:36.70,0:12:38.40,Default,,0,0,0,,Önemli bir şey değildi...
Dialogue: 0,0:12:41.74,0:12:44.38,Default,,0,0,0,,Oguri-chan'ın zafer konseri\N için sabırsızlanıyorum.
Dialogue: 0,0:12:44.83,0:12:48.13,Default,,0,0,0,,Eyvah. Hiç dans provası yapmadık...
Dialogue: 0,0:12:48.40,0:12:49.33,Default,,0,0,0,,Ne?
Dialogue: 0,0:12:49.54,0:12:50.58,Default,,0,0,0,,Eyvah...
Dialogue: 0,0:12:51.16,0:12:54.07,Default,,0,0,0,,Hey Norn, ne oldu orada\N iyi misin?
Dialogue: 0,0:12:54.10,0:12:56.35,Default,,0,0,0,,Neden planladığımız gibi yapmadın ki?
Dialogue: 0,0:12:57.55,0:12:59.09,Default,,0,0,0,,Bilerek yapmadım değil...
Dialogue: 0,0:12:59.59,0:13:00.52,Default,,0,0,0,,Yapamadım.
Dialogue: 0,0:13:01.42,0:13:02.66,Default,,0,0,0,,O kuvvetle...
Dialogue: 0,0:13:03.00,0:13:04.47,Default,,0,0,0,,Ayağına basmış olsaydım bile.
Dialogue: 0,0:13:04.63,0:13:05.97,Default,,0,0,0,,Havada uçuyor olurdum.
Dialogue: 0,0:13:06.85,0:13:07.39,Default,,0,0,0,,Cidden mi?
Dialogue: 0,0:13:08.59,0:13:10.09,Default,,0,0,0,,Birlikte yarıştıktan sonra anladım...
Dialogue: 0,0:13:11.35,0:13:13.48,Default,,0,0,0,,O kız... bambaşka bir seviyede.
Dialogue: 0,0:13:14.92,0:13:17.82,Default,,0,0,0,,Karşınızda muhteşem ilk zaferini alan, Oguri Cap!
Dialogue: 0,0:13:18.12,0:13:20.80,Default,,0,0,0,,İlk zafer konserinin tadını çıkarın.
Dialogue: 0,0:13:21.97,0:13:23.59,Default,,0,0,0,,- Yaparsın!\N-Sende bu iş!
Dialogue: 0,0:13:35.04,0:13:37.00,Default,,0,0,0,,Bu? Ne?
Dialogue: 0,0:13:39.88,0:13:41.26,Default,,0,0,0,,Bu,şey değil mi...
Dialogue: 0,0:13:47.83,0:13:56.36,Default,,0,0,0,,Mino'nun Kasamatsu'su,\Ngörülmeye değer bir güzellik.
Dialogue: 0,0:13:56.83,0:14:05.28,Default,,0,0,0,,Batıda İbuki, doğuda Kiso Yolu,
Dialogue: 0,0:14:05.62,0:14:16.88,Default,,0,0,0,,Ben Kiso Yolu'nun akıntısıyla büyüdüm. \NDans etmeyi iyi bilirim çiçek olsam da daha tomurcuğum.
Dialogue: 0,0:14:16.88,0:14:20.63,Default,,0,0,0,,-Utanç verici.\N- Haydi, haydi! Söyleyin, dans edin!
Dialogue: 0,0:14:20.63,0:14:23.48,Default,,0,0,0,,-Ona birkaç hareket öğreteyim bari.\N- Gönüller bir olsun.
Dialogue: 0,0:14:23.48,0:14:26.48,Default,,0,0,0,,{\an8}Ç.N:Şarkı sardı he
Dialogue: 0,0:14:23.48,0:14:29.60,Default,,0,0,0,,Gönüller bir olsun, haydi, haydi, haydi!\NKasamatsu Ondo'yla şan şan şan!
Dialogue: 0,0:14:31.02,0:14:33.02,Default,,0,0,0,,KASAMATSU YARIŞ PİSTİ
Dialogue: 0,0:14:37.51,0:14:38.72,Default,,0,0,0,,Seni görmek güzel.
Dialogue: 0,0:14:38.72,0:14:40.54,Default,,0,0,0,,Ee, nasıl gidiyor?
Dialogue: 0,0:14:41.29,0:14:45.46,Default,,0,0,0,,Aa, bu sabahın gazetesi mi?\NHerkes onu okuyor,bir sebebi var mı?
Dialogue: 0,0:14:45.88,0:14:47.16,Default,,0,0,0,,Nasıl desem.
Dialogue: 0,0:14:47.16,0:14:50.02,Default,,0,0,0,,{\an8} YENİ GENÇ YETENEK OGURI CAP
Dialogue: 0,0:14:47.16,0:14:50.02,Default,,0,0,0,,İlginç bir çaylak gelmiş.
Dialogue: 0,0:14:50.70,0:14:52.35,Default,,0,0,0,,Oguri... Cap?
Dialogue: 0,0:14:57.66,0:14:59.76,Default,,0,0,0,,Sanki eskisinden daha fazla yiyorsun...
Dialogue: 0,0:15:01.95,0:15:05.51,Default,,0,0,0,,Yarıştan sonra hemen\Nkarnım acıkıyor çok garip
Dialogue: 0,0:15:05.88,0:15:07.83,Default,,0,0,0,,Öyledir ama, midenin de bir sınırı vardır, değil mi?
Dialogue: 0,0:15:12.24,0:15:13.92,Default,,0,0,0,,Hey. Konuşmaya geldik.
Dialogue: 0,0:15:14.76,0:15:15.62,Default,,0,0,0,,Ne istiyorsunuz?
Dialogue: 0,0:15:17.37,0:15:20.03,Default,,0,0,0,,Kavga etmeye falan gelmedik.
Dialogue: 0,0:15:20.45,0:15:22.53,Default,,0,0,0,,Norn'un söyleyecekleri varmış.
Dialogue: 0,0:15:24.00,0:15:27.18,Default,,0,0,0,,Valizleri...boşalttım.
Dialogue: 0,0:15:28.68,0:15:30.81,Default,,0,0,0,,Hm? Eline sağlık?
Dialogue: 0,0:15:31.44,0:15:33.86,Default,,0,0,0,,Hey Norn bunu direkt söylemelisin.
Dialogue: 0,0:15:35.91,0:15:41.64,Default,,0,0,0,,Ah, kahre—odaya dönebileceğini söylüyorum!\NSen ve ben oda arkadaşıyız ya!
Dialogue: 0,0:15:42.27,0:15:43.11,Default,,0,0,0,,Öyle miydik?
Dialogue: 0,0:15:43.53,0:15:45.77,Default,,0,0,0,,Hep depoda yatıp kalkmak istemiyorsun, değil mi?
Dialogue: 0,0:15:45.84,0:15:48.69,Default,,0,0,0,,O odayı oldukça seviyordum ama.
Dialogue: 0,0:15:49.44,0:15:50.33,Default,,0,0,0,,Bir de.
Dialogue: 0,0:15:51.10,0:15:53.52,Default,,0,0,0,,Ailem dans stüdyosu işletiyor.
Dialogue: 0,0:15:54.11,0:15:56.94,Default,,0,0,0,,Seni öyle dans ederken izlemeye \Ngözlerim dayanmaz.
Dialogue: 0,0:15:57.75,0:15:59.90,Default,,0,0,0,,Al bunları, provaya gel.
Dialogue: 0,0:16:02.06,0:16:04.26,Default,,0,0,0,,Yine de çok istiyorsan,
Dialogue: 0,0:16:04.69,0:16:06.71,Default,,0,0,0,,sana öğretebilirim.
Dialogue: 0,0:16:12.29,0:16:14.62,Default,,0,0,0,,Bir de...seninle uğraştığım için üzgünüm.
Dialogue: 0,0:16:17.72,0:16:19.83,Default,,0,0,0,,Hadi gidiyoruz! Rudy! Mini!
Dialogue: 0,0:16:20.58,0:16:22.32,Default,,0,0,0,,B-Bekle!
Dialogue: 0,0:16:22.54,0:16:23.78,Default,,0,0,0,,Bu da neydi öyle?
Dialogue: 0,0:16:27.59,0:16:30.56,Default,,0,0,0,,Heeheehee, yüzün kıpkırmızı olmuş Norn!
Dialogue: 0,0:16:30.65,0:16:34.22,Default,,0,0,0,,Kes sesini!\NVe niye sadece ben özür diliyorum!
Dialogue: 0,0:16:34.52,0:16:35.64,Default,,0,0,0,,Siz de!
Dialogue: 0,0:16:35.97,0:16:37.91,Default,,0,0,0,,Ben mi? Neden?
Dialogue: 0,0:16:38.06,0:16:38.81,Default,,0,0,0,,Neden mi?
Dialogue: 0,0:16:39.05,0:16:42.05,Default,,0,0,0,,Ah!
Dialogue: 0,0:16:42.05,0:16:44.93,Default,,0,0,0,,March? Nereye gidiyor acaba?
Dialogue: 0,0:16:46.76,0:16:47.45,Default,,0,0,0,,BULDUM!
Dialogue: 0,0:16:51.83,0:16:54.70,Default,,0,0,0,,Sizi veletler...\Nyine provayı asabileceğinizi mi sanıyorsunuz?
Dialogue: 0,0:16:54.98,0:16:57.80,Default,,0,0,0,,İşte bu yüzden! Oguri'ye kaybettiniz.
Dialogue: 0,0:16:57.80,0:16:58.66,Default,,0,0,0,,Ne?
Dialogue: 0,0:16:58.99,0:17:00.71,Default,,0,0,0,,Ne diyon lan?
Dialogue: 0,0:17:00.71,0:17:04.42,Default,,0,0,0,,Duydunuz beni, \NBeğenmiyorsanız çalışın aptal üçlü!
Dialogue: 0,0:17:04.42,0:17:05.31,Default,,0,0,0,,Üç aptal mı?!
Dialogue: 0,0:17:05.31,0:17:07.64,Default,,0,0,0,,Tamam o zaman!\N O lafları sana yedirteceğiz!
Dialogue: 0,0:17:13.49,0:17:16.00,Default,,0,0,0,,Bundan sonra Arka arkaya yarışlarımız var!
Dialogue: 0,0:17:16.49,0:17:19.73,Default,,0,0,0,,Mesafe de artacak,\N ikiniz de dayanıklılığınızı artırın.
Dialogue: 0,0:17:20.27,0:17:22.17,Default,,0,0,0,,Ve Belno, ilk yarışın yakında!
Dialogue: 0,0:17:22.49,0:17:23.76,Default,,0,0,0,,Kendini ver!
Dialogue: 0,0:17:24.62,0:17:25.62,Default,,0,0,0,,T-Tamam..
Dialogue: 0,0:17:26.45,0:17:27.45,Default,,0,0,0,,Belno.
Dialogue: 0,0:17:28.89,0:17:30.17,Default,,0,0,0,,Ayakkabılar için teşekkür ederim.
Dialogue: 0,0:17:30.78,0:17:31.19,Default,,0,0,0,,Ne?
Dialogue: 0,0:17:32.21,0:17:36.03,Default,,0,0,0,,Aslında koşabildiğim sürece ayakkabı fark etmez diye düşünüyordum.
Dialogue: 0,0:17:36.86,0:17:39.00,Default,,0,0,0,,Bu kadar fark ediyormuş demek.
Dialogue: 0,0:17:39.07,0:17:40.58,Default,,0,0,0,,Koşması çok rahattı.
Dialogue: 0,0:17:41.72,0:17:44.69,Default,,0,0,0,,O yarışı senin sayende kazandım, Belno.
Dialogue: 0,0:17:50.11,0:17:52.30,Default,,0,0,0,,Birine yardımcı olabildiğini bilmek \Ngüzel bir his.
Dialogue: 0,0:17:53.55,0:17:56.76,Default,,0,0,0,,Sanki ben de onunla yarışı kazanmışım gibi.
Dialogue: 0,0:18:03.78,0:18:05.89,Default,,0,0,0,,Daha... gidemem...
Dialogue: 0,0:18:05.89,0:18:07.36,Default,,0,0,0,,Belno! Dayan!
Dialogue: 0,0:18:08.23,0:18:10.78,Default,,0,0,0,,Ama gerçekteki hâlim böyle.
Dialogue: 0,0:18:11.40,0:18:13.40,Default,,0,0,0,,{\fax-0.2\fay-0.1\pos(974,232)}{\pos(936,276)}Kinka Dağı şeması
Dialogue: 0,0:18:15.18,0:18:16.33,Default,,0,0,0,,İyi misin?
Dialogue: 0,0:18:16.87,0:18:18.16,Default,,0,0,0,,Üzgünwm...
Dialogue: 0,0:18:18.67,0:18:21.55,Default,,0,0,0,,Biraz su içip \N uzun bir mola verelim.
Dialogue: 0,0:18:22.09,0:18:24.04,Default,,0,0,0,,Tamamdır.İçecek alıp geliyorum.
Dialogue: 0,0:18:24.73,0:18:27.19,Default,,0,0,0,,Kusura bakma, Oguri-chan...teşekkür ederim.
Dialogue: 0,0:18:33.85,0:18:35.43,Default,,0,0,0,,Otomat neredeydi?
Dialogue: 0,0:18:46.00,0:18:47.00,Default,,0,0,0,,Oguri Cap...
Dialogue: 0,0:18:48.85,0:18:50.53,Default,,0,0,0,,O kız nereye gitti böyle?
Dialogue: 0,0:18:51.70,0:18:55.36,Default,,0,0,0,,Ah, buradasın demek...Ne? March?!
Dialogue: 0,0:18:55.90,0:18:56.90,Default,,0,0,0,,Ogur—
Dialogue: 0,0:18:57.61,0:18:58.75,Default,,0,0,0,,Shibasaki?
Dialogue: 0,0:19:00.40,0:19:03.40,Default,,0,0,0,,Şimdilik ikisini baş başa bırakın, lütfen.
Dialogue: 0,0:19:05.50,0:19:09.52,Default,,0,0,0,,Sanırım bu, baş başa\N ilk konuşmamız.
Dialogue: 0,0:19:10.50,0:19:12.22,Default,,0,0,0,,Öyle diken üstünde olmana gerek yok.
Dialogue: 0,0:19:13.17,0:19:15.72,Default,,0,0,0,,Sadece sana bir şey sormak istiyorum....
Dialogue: 0,0:19:16.57,0:19:18.22,Default,,0,0,0,,Senin hedeflediğin şey ne?
Dialogue: 0,0:19:19.36,0:19:20.36,Default,,0,0,0,,Hedefim mi?
Dialogue: 0,0:19:21.94,0:19:25.46,Default,,0,0,0,,Evet. Benim hedefim Tokai Derbisi.
Dialogue: 0,0:19:26.23,0:19:30.02,Default,,0,0,0,,Sadece Kasamatsu değil, tüm Tokai bölgesindeki yarışların zirvesi.
Dialogue: 0,0:19:30.25,0:19:33.67,Default,,0,0,0,,Bizim neslimizin en iyi koşucusunu belirleyecek yarış diyebilirsin.
Dialogue: 0,0:19:33.67,0:19:36.94,Default,,0,0,0,,Ve ben o zirvedeki manzarayı görmek istiyorum.
Dialogue: 0,0:19:38.80,0:19:40.83,Default,,0,0,0,,Sen ne için koşuyorsun?
Dialogue: 0,0:19:41.78,0:19:43.48,Default,,0,0,0,,Seni koşmaya iten şey ne?
Dialogue: 0,0:19:44.80,0:19:47.29,Default,,0,0,0,,İten... şey...
Dialogue: 0,0:19:49.95,0:19:51.82,Default,,0,0,0,,Seni neden sinir bozucu \Nbulduğumu şimdi anlıyorum.
Dialogue: 0,0:19:53.43,0:19:54.92,Default,,0,0,0,,Sen hızlısın.
Dialogue: 0,0:19:55.21,0:19:57.76,Default,,0,0,0,,Okulun en hızlısısındır muhtemelen.
Dialogue: 0,0:19:58.50,0:20:01.20,Default,,0,0,0,,Ancak bu gidişle, olabileceğin\N tek şey bu olacak.
Dialogue: 0,0:20:02.79,0:20:05.98,Default,,0,0,0,,Ulaşmak istediğin bir zirve yoksa, dağa tırmanmanın da bir anlamı yok.
Dialogue: 0,0:20:07.62,0:20:09.87,Default,,0,0,0,,Junior Crown'a katıl, Oguri Cap!
Dialogue: 0,0:20:10.92,0:20:14.78,Default,,0,0,0,,Benim için, Tokyo Derby'ye katılmaya layık olup olmadığımı belirleyecek yarış olacak.
Dialogue: 0,0:20:15.49,0:20:18.60,Default,,0,0,0,,Seni yenip zirveye gideceğim!
Dialogue: 0,0:20:21.48,0:20:23.12,Default,,0,0,0,,Kusura bakmayın, Jo-san.
Dialogue: 0,0:20:23.54,0:20:24.59,Default,,0,0,0,,Önemli değil.
Dialogue: 0,0:20:24.59,0:20:27.37,Default,,0,0,0,,Sen, buna ihtiyacı olduğunu düşündün, değil mi?
Dialogue: 0,0:20:28.00,0:20:29.43,Default,,0,0,0,,Anlayışınız için saolun.
Dialogue: 0,0:20:30.00,0:20:34.08,Default,,0,0,0,,Gerçi bu sohbetten bizim de bir şeyler kazandığımız söylenebilir.
Dialogue: 0,0:20:40.62,0:20:43.17,Default,,0,0,0,,Hedef... zirve...
Dialogue: 0,0:20:44.67,0:20:47.71,Default,,0,0,0,,Bunların benim için ne anlama geldiğinden\N pek emin değilim...
Dialogue: 0,0:20:49.12,0:20:50.12,Default,,0,0,0,,Ama, yine de.
Dialogue: 0,0:20:52.48,0:20:53.48,Default,,0,0,0,,Kabul etmeliyim ki...
Dialogue: 0,0:20:55.54,0:20:58.00,Default,,0,0,0,,Bu manzara oldukça güzel.
Dialogue: 0,0:22:33.02,0:22:35.29,Default,,0,0,0,,On beşinci Junior Crown'a hoş geldiniz!
Dialogue: 0,0:22:35.97,0:22:39.17,Default,,0,0,0,,Sıradaki Umamusume, son zamanlarda adından sıkça söz ettiren...
Dialogue: 0,0:22:39.55,0:22:42.07,Default,,0,0,0,,5. kulvar, 5 numara — Oguri Cap!
Dialogue: 0,0:22:42.78,0:22:45.43,Default,,0,0,0,,İlk yarışında Fujimasa March'a yenildi,
Dialogue: 0,0:22:46.04,0:22:48.64,Default,,0,0,0,,Ama bu kez intikamını alabilecek mi?
Dialogue: 0,0:22:51.60,0:22:52.60,Default,,0,0,0,,Yandım.
Dialogue: 0,0:22:53.00,0:22:55.59,Default,,0,0,0,,Hahaha, işte böyle hemen atılırsan \N böyle olur.
Dialogue: 0,0:22:56.00,0:22:57.23,Default,,0,0,0,,Başka ne yapabilirim ki?
Dialogue: 0,0:22:57.23,0:23:00.24,Default,,0,0,0,,{\an8}Ç.N:Kishimen (きしめん), Japonya'ya özgü yassı ve geniş bir udon türüdür.
Dialogue: 0,0:22:57.23,0:23:00.24,Default,,0,0,0,,Böyle yerlerde sık sık düz udon satan \Nbir mekân bulamazsın.
Dialogue: 0,0:23:02.76,0:23:04.17,Default,,0,0,0,,Shichimi'yi uzatır mısın?
Dialogue: 0,0:23:04.83,0:23:06.24,Default,,0,0,0,,Kasamatsu'ya ilk gelişin mi?
Dialogue: 0,0:23:06.69,0:23:07.52,Default,,0,0,0,,Evet öyle.
Dialogue: 0,0:23:08.07,0:23:09.87,Default,,0,0,0,,Yanlış trene bindim de.
Dialogue: 0,0:23:10.12,0:23:13.54,Default,,0,0,0,,Ama madem buradayım, bari bölgesel bir yarışa da göz atayım dedim.
Dialogue: 0,0:23:13.87,0:23:18.14,Default,,0,0,0,,Bölgesel mi? Yoksa sen ulusal—
Dialogue: 0,0:23:18.27,0:23:19.00,Default,,0,0,0,,Acı!
Dialogue: 0,0:23:20.54,0:23:21.99,Default,,0,0,0,,Hm? Uh-oh...
Dialogue: 0,0:23:22.44,0:23:23.65,Default,,0,0,0,,Yarış başlamak üzere!
Dialogue: 0,0:23:24.67,0:23:26.47,Default,,0,0,0,,Elinize sağlık\Nçok lezzetliydi
Dialogue: 0,0:23:26.47,0:23:27.76,Default,,0,0,0,,Sağol.
Dialogue: 0,0:23:28.32,0:23:30.22,Default,,0,0,0,,Küçük hanım, adını sormadım.
Dialogue: 0,0:23:32.19,0:23:33.57,Default,,0,0,0,,Adım Tamamo Cross!
Dialogue: 0,0:23:33.64,0:23:36.02,Default,,0,0,0,,TAMAMO CROSS
Dialogue: 0,0:23:39.12,0:23:42.52,Default,,0,0,0,,Gelecek Sefer\NUmamusume: Cinderella Gray!
Dialogue: 0,0:23:42.52,0:23:44.82,Default,,0,0,0,,Bölüm 4 - The Junior Crown
